---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { site, pillars } from '../config';
import { featuredArticles } from '../lib/content';
import { getSessionAccount } from '../lib/auth';
const account = await getSessionAccount(Astro.cookies.get('iftiin_session')?.value);
const highlighted = await featuredArticles(3, Boolean(account));
const root = (path = '') => import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//,'');
---
<Base>
  <section class="hero wrap">
    <div class="eyebrow"><span class="pulse-dot"></span> Independent knowledge platform <span class="eyebrow-line"></span> 2026 / Beyond</div>
    <h1>Make sense<br/>of <em>complexity.</em></h1>
    <div class="hero-bottom"><p>Ideen, Analysen und Lernräume an der Schnittstelle von Wissen, Technologie und menschlicher Handlungsfähigkeit.</p><a class="round-link" href={root('explore/')} aria-label="Themen entdecken">↗</a></div>
    <div class="orbit-mark" aria-hidden="true"><span></span><span></span><span></span><b>✳</b></div>
  </section>
  <section class="dark-section"><div class="wrap intro-layout"><div class="section-label light">01 / Our perspective</div><div><h2>Understand.<br/><i>Question.</i> Act.</h2><p>{site.mission}</p><a class="text-link light" href={root('about/')}>Mehr über unsere Perspektive <span>↗</span></a></div></div></section>
  <section class="section wrap" id="explore"><div class="section-heading"><div><div class="section-label">02 / Explore</div><h2>Five worlds.<br/><em>Connected thinking.</em></h2></div><p>Fünf Perspektiven auf die Frage, wie wir eine komplexer werdende Welt verstehen und gestalten können.</p></div><div class="pillars">{pillars.map(p=><a class="pillar-row" href={root(`topics/${p.slug}/`)}><span class="pillar-number">{p.number}</span><span class="pillar-main"><strong>{p.name}</strong><small>{p.question}</small></span><span class="pillar-arrow">↗</span></a>)}</div></section>
  {highlighted.length > 0 && <section class="section articles-section"><div class="wrap"><div class="section-heading"><div><div class="section-label">03 / Ideas</div><h2>Thoughts worth<br/><em>exploring.</em></h2></div><a href={root('explore/')} class="text-link">Alle Beiträge <span>↗</span></a></div><div class="card-grid">{highlighted.map(article=><ArticleCard article={article}/>)}</div></div></section>}
  <section class="manifesto wrap"><div class="section-label">{highlighted.length ? '04' : '03'} / An invitation</div><div><div class="manifesto-star" aria-hidden="true">✳</div><h2>Better questions.<br/>Clearer thinking.<br/><em>More agency.</em></h2><p>Hier entsteht Schritt für Schritt eine Wissensplattform mit Essays, Research Maps, Lernformaten und Werkzeugen.</p><a class="pill-link" href={root('explore/')}>Themen entdecken <span>↗</span></a></div></section>
</Base>
