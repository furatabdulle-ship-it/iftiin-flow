---
import ArrowIcon from '../components/ArrowIcon.astro';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import IftiinSun from '../components/brand/IftiinSun.astro';
import { localeHref, localizedFormatNames, t } from '../lib/i18n';
import { exploreArticles } from '../lib/articles';
import { getSessionAccount } from '../lib/auth';
const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
const formatNames = localizedFormatNames(locale);
const account = await getSessionAccount(Astro.cookies.get('iftiin_session')?.value);
if (account) Astro.response.headers.set('Cache-Control', 'private, no-store');
const highlighted = await exploreArticles(locale, 3, Boolean(account));
const feature = highlighted[0];
const root = (path = '') => localeHref(import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//, ''), locale);
const media = (file: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/about/${file}`;
---
<Base home description={copy('home.metaDescription')}>
  <nav class="home-section-nav" aria-label={copy('home.navLabel')}>
    <a href={root('explore/')}><span>01</span> {copy('common.explore')}</a>
    <a href={root('store/')}><span>02</span> {copy('common.shop')}</a>
    <a href={root('skills-navigator/')}><span>03</span> {copy('waitlist.title')}</a>
  </nav>

  <section class="hero" id="top" data-parallax>
    <div class="orbit" aria-hidden="true" data-orbit>
      <svg viewBox="0 0 1000 1000">
        <g class="orbit-dotted"><circle cx="500" cy="500" r="470" fill="none" stroke="#fff" stroke-width="1" stroke-dasharray="1 12" opacity=".35" /></g>
        <g class="orbit-spin"><ellipse cx="500" cy="500" rx="420" ry="210" fill="none" stroke="var(--violet)" stroke-width="1.5" /></g>
        <g class="orbit-spin-reverse"><ellipse cx="500" cy="500" rx="210" ry="420" fill="none" stroke="var(--violet)" stroke-width="1.5" /></g>
        <g class="orbit-inner"><circle cx="500" cy="500" r="330" fill="none" stroke="#fff" stroke-width="1" opacity=".18" /></g>
        <g class="orbit-dots">
          <circle cx="920" cy="500" r="16" fill="var(--yellow)" />
          <circle cx="80" cy="500" r="7" fill="var(--violet)" />
          <circle cx="500" cy="170" r="4" fill="#fff" />
        </g>
        <g class="orbit-star" fill="var(--yellow)" stroke="var(--yellow)" stroke-width="7" stroke-linecap="round">
          <line x1="500" y1="380" x2="500" y2="480" /><line x1="500" y1="520" x2="500" y2="620" />
          <line x1="380" y1="500" x2="480" y2="500" /><line x1="520" y1="500" x2="620" y2="500" />
          <line x1="433" y1="433" x2="483" y2="483" /><line x1="517" y1="517" x2="567" y2="567" />
          <line x1="567" y1="433" x2="517" y2="483" /><line x1="483" y1="517" x2="433" y2="567" />
          <circle cx="500" cy="500" r="14" stroke="none" />
        </g>
      </svg>
    </div>

    <div class="hero-layout">
      <div class="hero-copy">
        <div class="section-label hero-kicker">{copy('common.explore')}</div>
        <h1 class="hero-title">
          <span class="sr-only">{copy('home.heroTitle')}</span>
          <span class="hero-line" aria-hidden="true"><span>{locale === 'en' ? 'Make sense' : 'Verstehe'}</span></span>
          {locale === 'en' && <span class="hero-line" aria-hidden="true"><span class="outline">of</span></span>}
          <span class="hero-line rotator" aria-hidden="true"><span><span class="rotator-track" data-rotator>
            {(locale === 'en'
              ? ['noise.', 'AI.', 'power.', 'change.', 'Future Skills.']
              : ['Medien.', 'KI.', 'Macht.', 'Wandel.', 'Future Skills.']
            ).map((term) => <span>{term}</span>)}
          </span></span></span>
        </h1>
        <p class="hero-description">{copy('home.heroDescription')}</p>
        <div class="hero-ctas">
          <a class="pill-link hero-cta-primary" href={root('explore/')}>{copy('home.pillarsCta')} <ArrowIcon /></a>
          <a class="hero-cta-secondary" href={root('skills-navigator/')}>{copy('home.navigatorCta')} <ArrowIcon /></a>
        </div>
        <ul class="hero-topics" aria-label={copy('home.topicsLabel')}>
          {(['education', 'technology', 'storytelling'] as const).map((pillar) => <li>{copy(`home.pillar.${pillar}`)}</li>)}
        </ul>
      </div>

      <div class="hero-feature-column">
        {feature ? <a class="hero-feature-card" href={root(`articles/${feature.slug}/`)}>
          <div class="hero-feature-art">
            <span>{formatNames[feature.data.format] || copy('article.formatFallback')}</span>
            <h2>{feature.data.title}</h2>
            <IftiinSun size={124} class="hero-feature-sun" />
          </div>
          <div class="hero-feature-body">
            <div class="hero-feature-meta">{formatNames[feature.data.format] || copy('article.formatFallback')}</div>
            <p>{feature.data.description}</p>
            <span class="hero-feature-link">{copy('home.articleRead')} <ArrowIcon /></span>
          </div>
        </a> : <a class="hero-feature-card" href={root('explore/')}>
          <div class="hero-feature-art">
            <span>{copy('common.explore')}</span>
            <h2>{copy('common.explore')}</h2>
            <IftiinSun size={124} class="hero-feature-sun" />
          </div>
          <div class="hero-feature-body">
            <div class="hero-feature-meta">{copy('explore.allArticles')}</div>
            <p>{copy('explore.description')}</p>
            <span class="hero-feature-link">{copy('home.discoverTopics')} <ArrowIcon /></span>
          </div>
        </a>}

        <a class="hero-shop-card" href={root('store/')}>
          <div class="hero-shop-copy">
            <div class="section-label">{copy('store.label')}</div>
            <h2>{copy('store.tagline')}</h2>
            <p>{copy('home.shopDescription')}</p>
            <span>{copy('home.shopCta')} <ArrowIcon /></span>
          </div>
          <div class="hero-workbook" aria-hidden="true"><IftiinSun size={88} color="var(--violet)" /></div>
        </a>
      </div>
    </div>

    <div class="hero-foot">
      <span class="hero-foot-side">{copy('common.announcement')}</span>
      <a class="badge" href="#pillars" aria-label={copy('home.discoverTopics')}>
        <svg viewBox="0 0 140 140" aria-hidden="true">
          <defs><path id="badge-circle" d="M70,70 m-54,0 a54,54 0 1,1 108,0 a54,54 0 1,1 -108,0" /></defs>
          <text><textPath href="#badge-circle">UNDERSTAND · QUESTION · ACT · </textPath></text>
        </svg>
        <span class="badge-arrow" aria-hidden="true"><ArrowIcon direction="down" /></span>
      </a>
      <span class="hero-foot-side hero-foot-side--right">{copy('home.understand')}</span>
    </div>
  </section>

  <section class="home-navigator section wrap" id="skills-navigator" aria-labelledby="home-navigator-title">
    <div class="section-label">{copy('waitlist.eyebrow')}</div>
    <div class="home-navigator-content">
      <h2 id="home-navigator-title">{copy('waitlist.title')}</h2>
      <p class="home-navigator-question">{copy('waitlist.question')}</p>
      <p>{copy('waitlist.description')}</p>
      <p>{copy('waitlist.timeline')}</p>
      <a class="pill-link" href={root('skills-navigator/')}>{copy('waitlist.cta')} <ArrowIcon /></a>
    </div>
  </section>

  {highlighted.length > 1 && <section class="section articles-section" id="ideas"><div class="wrap">
    <div class="section-heading"><div><div class="section-label">01 / {copy('home.visions')}</div><h2>Thoughts worth<br /><em>exploring.</em></h2></div><a href={root('explore/')} class="text-link">{copy('home.allArticles')} <ArrowIcon /></a></div>
    <div class="card-grid">{highlighted.slice(1).map(article => <ArticleCard article={article} />)}</div>
  </div></section>}

  <section class="dark-section" id="perspective"><div class="wrap intro-layout">
    <div class="section-label light">02 / Our perspective</div>
    <div>
      <h2>Think deeply.<br /><i>Create what’s next.</i></h2>
      <p>{copy('home.perspectiveCopyFirst')}</p>
      <p>{copy('home.perspectiveCopySecond')}</p>
      <p>{copy('home.perspectiveCopyThird')}</p>
      <a class="text-link light" href={root('about/')}>{copy('home.perspectiveLink')} <ArrowIcon /></a>
    </div>
  </div></section>

  {locale === 'en' && <section class="home-founder" aria-labelledby="home-founder-title">
    <div class="wrap home-founder-inner">
      <figure class="home-founder-portrait">
        <img
          src={media('furat-summit.jpg')}
          alt="Furat Abdulle at the Black Girls Tech Summit 2025"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Black Girls Tech Summit 2025</figcaption>
      </figure>
      <div class="home-founder-copy">
        <div class="section-label">{copy('home.founderEyebrow')}</div>
        <h2 id="home-founder-title">Furat Abdulle</h2>
        <p>{copy('home.founderDescription')}</p>
        <a class="text-link light" href={root('about/')}>{copy('home.founderLink')} <ArrowIcon /></a>
      </div>
    </div>
  </section>}

  <section class="worlds home-pillars-section" id="pillars">
    <div class="worlds-head"><div><div class="section-label">03 / {copy('home.pillarsLabel')}</div><h2>{copy('home.pillarsTitle')}</h2></div>
      <p>{copy('home.pillarsIntro')}</p>
    </div>
    <ul class="world-list home-pillars">
      {(['education', 'technology', 'storytelling'] as const).map((pillar, index) => <li class="home-pillar">
        <span class="world-number">{String(index + 1).padStart(2, '0')}</span>
        <span class="world-body">
          <h3 class="world-name">{copy(`home.pillar.${pillar}`)}</h3>
          <p class="world-question">{copy(`home.pillar.${pillar}.description`)}</p>
        </span>
      </li>)}
    </ul>
  </section>

  <section class="manifesto wrap" id="invitation"><div class="section-label">05 / {copy('home.invitation')}</div><div>
    <IftiinSun size={56} class="manifesto-sun" /><h2>Better questions.<br />Clearer thinking.<br /><em>More agency.</em></h2>
    <p>{copy('home.manifestoDescription')}</p>
    <a class="pill-link" href={root('explore/')}>{copy('home.discoverTopics')} <ArrowIcon /></a>
  </div></section>
</Base>
