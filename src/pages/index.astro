---
import ArrowIcon from '../components/ArrowIcon.astro';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import StorePriceOptions from '../components/StorePriceOptions.astro';
import { localeHref, t } from '../lib/i18n';
import { exploreArticles } from '../lib/articles';
import { listPublicProducts } from '../lib/commerce';
import { isCheckoutConfigured } from '../lib/stripe';
const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
const articles = await exploreArticles(locale, 3);
const availableProducts = isCheckoutConfigured() ? await listPublicProducts() : [];
const products = availableProducts
  .filter((product) =>
    product.description.trim()
    && product.content.length > 0
    && (locale !== 'en' || (
      product.nameEn
      && product.descriptionEn
      && product.content.every((item) => item.titleEn)
    )),
  )
  .slice(0, 3);
const typeNames: Record<string, string> = {
  digital_download: copy('store.digitalDownload'),
  premium_article: copy('store.premiumArticle'),
  online_course: copy('store.onlineCourse'),
  bundle: copy('store.bundle'),
  membership: copy('store.membership'),
};
const root = (path = '') => localeHref(import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//, ''), locale);
const media = (file: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/about/${file}`;
---
<Base home description={copy('home.metaDescription')}>
  <nav class="home-section-nav" aria-label={copy('home.navLabel')}>
    <a href="#community"><span>01</span> {copy('common.community')}</a>
    <a href="#ideas"><span>02</span> {copy('common.explore')}</a>
    <a href={root('store/')}><span>03</span> {copy('common.shop')}</a>
  </nav>

  <section class="hero hero--statement" id="top" data-parallax>
    <div class="orbit" aria-hidden="true" data-orbit>
      <svg viewBox="0 0 1000 1000">
        <g class="orbit-dotted"><circle cx="500" cy="500" r="470" fill="none" stroke="#fff" stroke-width="1" stroke-dasharray="1 12" opacity=".35" /></g>
        <g class="orbit-spin"><ellipse cx="500" cy="500" rx="420" ry="210" fill="none" stroke="var(--violet)" stroke-width="1.5" /></g>
        <g class="orbit-spin-reverse"><ellipse cx="500" cy="500" rx="210" ry="420" fill="none" stroke="var(--violet)" stroke-width="1.5" /></g>
        <g class="orbit-inner"><circle cx="500" cy="500" r="330" fill="none" stroke="#fff" stroke-width="1" opacity=".18" /></g>
        <g class="orbit-dots">
          <circle cx="920" cy="500" r="16" fill="var(--yellow)" />
          <circle cx="80" cy="500" r="7" fill="var(--violet)" />
          <circle cx="500" cy="170" r="4" fill="#fff" />
        </g>
        <g class="orbit-star" fill="var(--yellow)" stroke="var(--yellow)" stroke-width="7" stroke-linecap="round">
          <line x1="500" y1="380" x2="500" y2="480" /><line x1="500" y1="520" x2="500" y2="620" />
          <line x1="380" y1="500" x2="480" y2="500" /><line x1="520" y1="500" x2="620" y2="500" />
          <line x1="433" y1="433" x2="483" y2="483" /><line x1="517" y1="517" x2="567" y2="567" />
          <line x1="567" y1="433" x2="517" y2="483" /><line x1="483" y1="517" x2="433" y2="567" />
          <circle cx="500" cy="500" r="14" stroke="none" />
        </g>
      </svg>
    </div>

    <div class="hero-layout hero-layout--single">
      <div class="hero-copy">
        <div class="section-label hero-kicker">{copy('home.heroEyebrow')}</div>
        <h1 class="hero-title hero-title--statement">{copy('home.heroTitle')}</h1>
        <p class="hero-description">{copy('home.heroDescription')}</p>
        <div class="hero-ctas">
          <a class="pill-link hero-cta-primary" href={root('community/')}>{copy('home.communityCta')} <ArrowIcon /></a>
          <a class="hero-cta-secondary" href={root('explore/')}>{copy('home.exploreCta')} <ArrowIcon /></a>
        </div>
        <p class="home-hero-access-note">{copy('home.heroAccessNote')}</p>
      </div>
    </div>
  </section>

  <section class="home-community" id="community" aria-labelledby="home-community-title">
    <div class="wrap home-community-grid">
      <div class="home-community-copy">
        <p class="section-label">{copy('home.communitySectionEyebrow')}</p>
        <h2 id="home-community-title">{copy('home.communitySectionTitle')}</h2>
        <p class="home-community-lede">{copy('home.communitySectionDescription')}</p>
        <a class="pill-link home-community-cta" href={root('community/')}>{copy('home.communityCta')} <ArrowIcon /></a>
      </div>
      <div class="home-community-panel">
        <ul class="home-community-benefits">
          <li>{copy('home.communityBenefitSkills')}</li>
          <li>{copy('home.communityBenefitPossibilities')}</li>
          <li>{copy('home.communityBenefitExchange')}</li>
        </ul>
        <p class="home-community-note">{copy('home.communityAccessNote')}</p>
        <a class="home-community-free-link" href={root('explore/')}>{copy('home.freeContentLink')} <ArrowIcon /></a>
      </div>
    </div>
  </section>

  <section class="section articles-section home-free-section" id="ideas">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <div class="section-label">01 / {copy('home.freeKnowledgeEyebrow')}</div>
          <h2>{copy('home.freeKnowledgeTitle')}</h2>
          <p>{copy('home.freeKnowledgeDescription')}</p>
        </div>
        <a href={root('explore/')} class="text-link">{copy('home.allArticles')} <ArrowIcon /></a>
      </div>
      {articles.length > 0
        ? <div class="card-grid">{articles.map(article => <ArticleCard article={article} />)}</div>
        : <p class="home-free-empty">{copy('explore.emptyDescription')}</p>}
    </div>
  </section>

  <section class="worlds home-pillars-section" id="pillars">
    <div class="worlds-head"><div><div class="section-label">02 / {copy('home.pillarsLabel')}</div><h2>{copy('home.pillarsTitle')}</h2></div>
      <p>{copy('home.pillarsIntro')}</p>
    </div>
    <ul class="world-list home-pillars">
      {(['education', 'technology', 'storytelling'] as const).map((pillar, index) => <li class="home-pillar">
        <span class="world-number">{String(index + 1).padStart(2, '0')}</span>
        <span class="world-body">
          <h3 class="world-name">{copy(`home.pillar.${pillar}`)}</h3>
          <p class="world-question">{copy(`home.pillar.${pillar}.description`)}</p>
        </span>
      </li>)}
    </ul>
  </section>

  {products.length > 0 && <section class="section home-resources" id="resources" aria-labelledby="home-resources-title">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <div class="section-label">03 / {copy('home.resourcesEyebrow')}</div>
          <h2 id="home-resources-title">{copy('home.resourcesTitle')}</h2>
          <p>{copy('home.resourcesDescription')}</p>
        </div>
        <a href={root('store/')} class="text-link">{copy('home.shopCta')} <ArrowIcon /></a>
      </div>
      <div class="home-products-grid">
        {products.map((product) => {
          const name = locale === 'en' ? product.nameEn ?? product.name : product.name;
          const description = locale === 'en' ? product.descriptionEn : product.description;
          return <article class="home-product-card">
            {product.coverAssetId && <img
              class="home-product-cover"
              src={root(`api/store/products/${encodeURIComponent(product.slug)}/cover/`)}
              alt=""
              loading="lazy"
              decoding="async"
            />}
            <p class="home-product-type">{typeNames[product.productType]}</p>
            <h3>{name}</h3>
            <p class="home-product-description">{description}</p>
            <StorePriceOptions product={product} mode="summary" />
            <a class="home-product-link" href={root(`store/${encodeURIComponent(product.slug)}/`)}>
              {copy('store.viewProduct')} <ArrowIcon />
            </a>
          </article>;
        })}
      </div>
    </div>
  </section>}

  <section class="home-founder home-proof" aria-labelledby="home-founder-title">
    <div class="wrap home-founder-inner">
      <figure class="home-founder-portrait">
        <img
          src={media('furat-summit.jpg')}
          alt={copy('home.founderImageAlt')}
          loading="lazy"
          decoding="async"
        />
        <figcaption>{copy('home.founderImageCaption')}</figcaption>
      </figure>
      <div class="home-founder-copy">
        <div class="section-label">{copy('home.founderEyebrow')}</div>
        <h2 id="home-founder-title">Furat Abdulle</h2>
        <p>{copy('home.founderDescription')}</p>
        <div class="home-references">
          <p class="section-label">{copy('home.referencesEyebrow')}</p>
          <p>{copy('home.referencesDescription')}</p>
        </div>
        <a class="text-link light" href={root('about/#appearances')}>{copy('home.founderLink')} <ArrowIcon /></a>
      </div>
    </div>
  </section>
</Base>
