---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { site, pillars } from '../config';
import { featuredArticles } from '../lib/content';
import { getSessionAccount } from '../lib/auth';
const account = await getSessionAccount(Astro.cookies.get('iftiin_session')?.value);
const highlighted = await featuredArticles(3, Boolean(account));
const root = (path = '') => import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//, '');
---
<Base home>
  <section class="hero" id="top" data-parallax>
    <div class="orbit" aria-hidden="true" data-orbit>
      <svg viewBox="0 0 1000 1000">
        <g class="orbit-dotted"><circle cx="500" cy="500" r="470" fill="none" stroke="#fff" stroke-width="1" stroke-dasharray="1 12" opacity=".35" /></g>
        <g class="orbit-spin"><ellipse cx="500" cy="500" rx="420" ry="210" fill="none" stroke="var(--violet)" stroke-width="1.5" /></g>
        <g class="orbit-spin-reverse"><ellipse cx="500" cy="500" rx="210" ry="420" fill="none" stroke="var(--violet)" stroke-width="1.5" /></g>
        <g class="orbit-inner"><circle cx="500" cy="500" r="330" fill="none" stroke="#fff" stroke-width="1" opacity=".18" /></g>
        <g class="orbit-dots">
          <circle cx="920" cy="500" r="16" fill="var(--yellow)" />
          <circle cx="80" cy="500" r="7" fill="var(--violet)" />
          <circle cx="500" cy="170" r="4" fill="#fff" />
        </g>
        <g class="orbit-star" fill="var(--yellow)" stroke="var(--yellow)" stroke-width="7" stroke-linecap="round">
          <line x1="500" y1="380" x2="500" y2="480" /><line x1="500" y1="520" x2="500" y2="620" />
          <line x1="380" y1="500" x2="480" y2="500" /><line x1="520" y1="500" x2="620" y2="500" />
          <line x1="433" y1="433" x2="483" y2="483" /><line x1="517" y1="517" x2="567" y2="567" />
          <line x1="567" y1="433" x2="517" y2="483" /><line x1="483" y1="517" x2="433" y2="567" />
          <circle cx="500" cy="500" r="14" stroke="none" />
        </g>
      </svg>
    </div>

    <div class="hero-title-wrap">
      <h1 class="hero-title">
        <span class="sr-only">Make sense of the noise, AI, power and change.</span>
        <span class="hero-line" aria-hidden="true"><span>Make sense</span></span>
        <span class="hero-line" aria-hidden="true"><span class="outline">of the</span></span>
        <span class="hero-line rotator" aria-hidden="true"><span><span class="rotator-track" data-rotator>
          <span>noise.</span><span>AI.</span><span>power.</span><span>change.</span>
        </span></span></span>
      </h1>
    </div>

    <div class="hero-foot">
      <p>Ideen, Analysen und Lernräume an der Schnittstelle von Wissen, Technologie und Handlungsfähigkeit – und der Frage, wer gestalten darf.</p>
      <a class="badge" href="#explore" aria-label="Zu den Themenwelten">
        <svg viewBox="0 0 140 140" aria-hidden="true">
          <defs><path id="badge-circle" d="M70,70 m-54,0 a54,54 0 1,1 108,0 a54,54 0 1,1 -108,0" /></defs>
          <text><textPath href="#badge-circle">UNDERSTAND · QUESTION · ACT · </textPath></text>
        </svg>
        <span class="badge-arrow" aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  {highlighted.length > 0 && <section class="section articles-section"><div class="wrap">
    <div class="section-heading"><div><div class="section-label">01 / Ideas</div><h2>Thoughts worth<br /><em>exploring.</em></h2></div><a href={root('explore/')} class="text-link">Alle Beiträge <span>↗</span></a></div>
    <div class="card-grid">{highlighted.map(article => <ArticleCard article={article} />)}</div>
  </div></section>}

  <section class="dark-section"><div class="wrap intro-layout">
    <div class="section-label light">02 / Our perspective</div>
    <div><h2>Understand.<br /><i>Question.</i> Act.</h2><p>{site.mission}</p><a class="text-link light" href={root('about/')}>Mehr über unsere Perspektive <span>↗</span></a></div>
  </div></section>

  <section class="worlds" id="explore">
    <div class="worlds-head"><div><div class="section-label">03 / Explore</div><h2>Fünf Welten.<br /><span>Ein Denken.</span></h2></div>
      <p>Fünf Perspektiven auf die Frage, wie wir eine komplexer werdende Welt verstehen und gestalten können.</p>
    </div>
    <ul class="world-list">
      {pillars.map(p => <li><a class="world" href={root(`topics/${p.slug}/`)}>
        <span class="world-number">{p.number}</span>
        <span class="world-body"><span class="world-name">{p.name}</span><span class="world-question">{p.question}</span></span>
        <span class="world-arrow" aria-hidden="true">↗</span>
      </a></li>)}
    </ul>
  </section>

  <section class="manifesto wrap"><div class="section-label">04 / An invitation</div><div>
    <div class="manifesto-star" aria-hidden="true">✳</div><h2>Better questions.<br />Clearer thinking.<br /><em>More agency.</em></h2>
    <p>Hier entsteht Schritt für Schritt eine Wissensplattform mit Essays, Research Maps, Lernformaten und Werkzeugen.</p>
    <a class="pill-link" href={root('explore/')}>Themen entdecken <span>↗</span></a>
  </div></section>
</Base>
