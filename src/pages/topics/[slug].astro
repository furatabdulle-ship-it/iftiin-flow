---
import ArrowIcon from '../../components/ArrowIcon.astro';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import IftiinSun from '../../components/brand/IftiinSun.astro';
import { localeHref, localizedPillars, t } from '../../lib/i18n';
import { publishedArticles } from '../../lib/content';
import { getSessionAccount } from '../../lib/auth';
const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
const pillars = localizedPillars(locale);
const root = (path = '') => localeHref(import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//,''), locale);
const legacyTopicTargets: Record<string, string> = {
  'knowledge-agency': 'explore/',
  'ai-domain': 'explore/',
  'institutions-work-power': 'topics/systems-power/',
  'human-capability': 'topics/skills-agency/',
  'culture-meaning': 'topics/systems-power/',
};
const pillar = pillars.find((item) => item.slug === Astro.params.slug);
if (!pillar) {
  const legacyTarget = legacyTopicTargets[Astro.params.slug ?? ''];
  return Astro.redirect(root(legacyTarget ?? 'explore/'), legacyTarget ? 301 : 302);
}
const account = await getSessionAccount(Astro.cookies.get('iftiin_session')?.value);
const articles = (await publishedArticles(Boolean(account), locale)).filter(a => a.data.pillar === pillar.slug);
---
<Base title={pillar.name} description={pillar.description}>
  <section class="interior-hero wrap">
    <a class="breadcrumb" href={root('explore/')}><ArrowIcon direction="left" /> {copy('topic.breadcrumb')}</a>
    <div class="section-label">{copy('topic.label')} / {pillar.number}</div>
    <h1>{pillar.name}</h1>
    <p>{pillar.question}</p>
  </section>
  <section class="section wrap compact-section">
    <p class="topic-intro">{pillar.description}</p>
    <div class="section-heading tight"><h2>{copy('topic.perspectives')}</h2></div>
    {articles.length
      ? <div class="card-grid">{articles.map(a => <ArticleCard article={a} />)}</div>
      : <div class="empty-state">
        <IftiinSun class="empty-symbol" color="var(--violet)" />
        <h3>{copy('topic.emptyTitle')}</h3>
        <p>{copy('topic.emptyDescription')}</p>
      </div>}
  </section>
</Base>
