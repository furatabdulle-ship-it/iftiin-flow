---
import ArrowIcon from '../../components/ArrowIcon.astro';
import Base from '../../layouts/Base.astro';
import { getSessionAccount } from '../../lib/auth';
import { getCommunityProfile } from '../../lib/community';
import { localeHref } from '../../lib/i18n';

const locale = Astro.locals.locale;
const en = locale === 'en';
const account = await getSessionAccount(Astro.cookies.get('iftiin_session')?.value);
if (!account) return Astro.redirect(localeHref('/login/?next=/community/profile/', locale), 302);
Astro.response.headers.set('Cache-Control', 'private, no-store');
const profile = await getCommunityProfile(account.id);
const interestOptions = [
  { value: 'future-skills', label: en ? 'Future Skills' : 'Zukunftskompetenzen' },
  { value: 'ai-literacy', label: en ? 'AI Literacy' : 'KI-Kompetenz' },
  { value: 'media-literacy', label: en ? 'Media Literacy' : 'Medienkompetenz' },
  { value: 'storytelling', label: en ? 'Storytelling' : 'Storytelling' },
] as const;
---
<Base title={en ? 'Community profile' : 'Community-Profil'}>
  <section class="interior-hero wrap community-hero">
    <div class="section-label">{en ? 'Your community presence' : 'Dein Auftritt in der Community'}</div>
    <h1>{en ? 'Your profile, your choice.' : 'Dein Profil. Deine Entscheidung.'}</h1>
    <p>{en
      ? 'Your profile is private by default. Choose whether to appear in the member directory and exactly which details other signed-in members can see.'
      : 'Dein Profil ist standardmäßig privat. Entscheide, ob du im Mitgliederverzeichnis erscheinen möchtest und welche Angaben andere angemeldete Mitglieder sehen dürfen.'}</p>
    <div class="community-panel">
      <form class="community-form" id="community-profile-form" data-locale={locale}
        data-saving={en ? 'Saving your profile…' : 'Profil wird gespeichert …'}
        data-saved={en ? 'Your profile has been saved.' : 'Dein Profil wurde gespeichert.'}
        data-error={en ? 'Your profile could not be saved. Please try again.' : 'Dein Profil konnte nicht gespeichert werden. Bitte versuche es erneut.'}>
        <label class="community-field" for="community-headline">
          {en ? 'Headline' : 'Überschrift'}
          <input id="community-headline" name="headline" type="text" maxlength="120" value={profile.headline} />
        </label>
        <p class="community-field-hint">{en ? 'A short introduction, such as your role or focus.' : 'Eine kurze Vorstellung, zum Beispiel deine Rolle oder dein Schwerpunkt.'}</p>
        <label class="community-field" for="community-bio">
          {en ? 'About you' : 'Über dich'}
          <textarea id="community-bio" name="bio" maxlength="1000">{profile.bio}</textarea>
        </label>
        <label class="community-field" for="community-location">
          {en ? 'Location' : 'Ort'}
          <input id="community-location" name="location" type="text" maxlength="120" value={profile.location} />
        </label>
        <label class="community-field" for="community-learning-goals">
          {en ? 'Personal learning goals' : 'Persönliche Lernziele'}
          <textarea id="community-learning-goals" name="personalLearningGoals" maxlength="1000">{profile.personalLearningGoals}</textarea>
        </label>
        <p class="community-field-hint">{en
          ? 'Private to you. These goals are never shown in the member directory.'
          : 'Nur für dich sichtbar. Diese Lernziele erscheinen niemals im Mitgliederverzeichnis.'}</p>
        <label class="community-field" for="community-website">
          {en ? 'Website' : 'Website'}
          <input id="community-website" name="website" type="url" maxlength="2048" placeholder="https://…" value={profile.website} />
        </label>
        <label class="community-field" for="community-linkedin">
          LinkedIn
          <input id="community-linkedin" name="linkedinUrl" type="url" maxlength="2048" placeholder="https://www.linkedin.com/in/…" value={profile.linkedinUrl} />
        </label>
        <label class="community-field" for="community-picture">
          {en ? 'Profile picture URL' : 'URL des Profilbilds'}
          <input id="community-picture" name="profilePictureUrl" type="url" maxlength="2048" placeholder="https://…" value={profile.profilePictureUrl} />
        </label>
        <p class="community-field-hint">{en
          ? 'Use an HTTPS image URL. It is shared only if you select it below.'
          : 'Verwende eine HTTPS-Bild-URL. Sie wird nur geteilt, wenn du sie unten auswählst.'}</p>
        <fieldset class="community-share-options">
          <legend>{en ? 'Interests' : 'Interessen'}</legend>
          {interestOptions.map((interest) => <label class="community-share-option">
            <input name="interests" type="checkbox" value={interest.value} checked={profile.interests.includes(interest.value)} />
            <span>{interest.label}</span>
          </label>)}
        </fieldset>
        <label class="community-field" for="community-expertise">
          {en ? 'Areas of expertise' : 'Fachgebiete'}
          <textarea id="community-expertise" name="expertise" maxlength="400">{profile.expertise.join('\n')}</textarea>
        </label>
        <p class="community-field-hint">{en
          ? 'Add up to 8 short tags, one per line (40 characters each).'
          : 'Füge bis zu 8 kurze Schlagwörter hinzu, eines pro Zeile (je 40 Zeichen).'}
        </p>
        <label class="community-visibility">
          <input name="isVisible" type="checkbox" checked={profile.isVisible} />
          <span><strong>{en ? 'Show my profile in the member directory' : 'Mein Profil im Mitgliederverzeichnis anzeigen'}</strong><br />{en
            ? 'Only signed-in members can view the directory. You can turn this off at any time.'
            : 'Das Verzeichnis ist nur für angemeldete Mitglieder sichtbar. Du kannst diese Einstellung jederzeit ausschalten.'}</span>
        </label>
        <fieldset class="community-share-options">
          <legend>{en ? 'Choose what members may see' : 'Wähle aus, was Mitglieder sehen dürfen'}</legend>
          <label class="community-share-option"><input name="showDisplayName" type="checkbox" checked={profile.showDisplayName} /><span>{en ? `Display name (${account.displayName})` : `Anzeigename (${account.displayName})`}</span></label>
          <label class="community-share-option"><input name="showHeadline" type="checkbox" checked={profile.showHeadline} /><span>{en ? 'Headline' : 'Überschrift'}</span></label>
          <label class="community-share-option"><input name="showBio" type="checkbox" checked={profile.showBio} /><span>{en ? 'About you' : 'Über dich'}</span></label>
          <label class="community-share-option"><input name="showLocation" type="checkbox" checked={profile.showLocation} /><span>{en ? 'Location' : 'Ort'}</span></label>
          <label class="community-share-option"><input name="showWebsite" type="checkbox" checked={profile.showWebsite} /><span>{en ? 'Website' : 'Website'}</span></label>
          <label class="community-share-option"><input name="showLinkedIn" type="checkbox" checked={profile.showLinkedIn} /><span>LinkedIn</span></label>
          <label class="community-share-option"><input name="showProfilePicture" type="checkbox" checked={profile.showProfilePicture} /><span>{en ? 'Profile picture' : 'Profilbild'}</span></label>
          <label class="community-share-option"><input name="showInterests" type="checkbox" checked={profile.showInterests} /><span>{en ? 'Interests' : 'Interessen'}</span></label>
          <label class="community-share-option"><input name="showExpertise" type="checkbox" checked={profile.showExpertise} /><span>{en ? 'Areas of expertise' : 'Fachgebiete'}</span></label>
        </fieldset>
        <p class="community-privacy-note">{en
          ? 'Your email address is never shown in the member directory. Unselected fields remain private, even when your profile is visible.'
          : 'Deine E-Mail-Adresse wird im Mitgliederverzeichnis niemals angezeigt. Nicht ausgewählte Felder bleiben privat – auch wenn dein Profil sichtbar ist.'}</p>
        <p class="form-message" id="community-profile-message" role="status" aria-live="polite"></p>
        <div class="community-actions">
          <button class="pill-link" type="submit">{en ? 'Save profile' : 'Profil speichern'} <ArrowIcon /></button>
          <a class="text-link" href={localeHref('/community/members/', locale)}>{en ? 'Browse member directory' : 'Mitgliederverzeichnis ansehen'} <ArrowIcon /></a>
          <a class="text-link" href={localeHref('/community/saved-resources/', locale)}>{en ? 'View saved resources' : 'Gespeicherte Ressourcen ansehen'} <ArrowIcon /></a>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  const profileForm = document.querySelector<HTMLFormElement>('#community-profile-form');
  const profileMessage = document.querySelector<HTMLElement>('#community-profile-message');

  profileForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!profileForm || !profileMessage) return;
    const data = new FormData(profileForm);
    const checked = (name: string) => (profileForm.elements.namedItem(name) as HTMLInputElement).checked;
    const button = profileForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    profileMessage.textContent = profileForm.dataset.saving ?? 'Saving…';
    profileForm.setAttribute('aria-busy', 'true');
    if (button) button.disabled = true;
    try {
      const response = await fetch('/api/community/profile/', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          headline: data.get('headline'),
          bio: data.get('bio'),
          location: data.get('location'),
          personalLearningGoals: data.get('personalLearningGoals'),
          website: data.get('website'),
          linkedinUrl: data.get('linkedinUrl'),
          profilePictureUrl: data.get('profilePictureUrl'),
          interests: data.getAll('interests'),
          expertise: (data.get('expertise')?.toString() ?? '')
            .split(/[\n,]/)
            .map((tag) => tag.trim())
            .filter(Boolean),
          isVisible: checked('isVisible'),
          showDisplayName: checked('showDisplayName'),
          showHeadline: checked('showHeadline'),
          showBio: checked('showBio'),
          showLocation: checked('showLocation'),
          showWebsite: checked('showWebsite'),
          showLinkedIn: checked('showLinkedIn'),
          showProfilePicture: checked('showProfilePicture'),
          showInterests: checked('showInterests'),
          showExpertise: checked('showExpertise'),
        }),
      });
      if (!response.ok) throw new Error();
      profileMessage.textContent = profileForm.dataset.saved ?? 'Your profile has been saved.';
    } catch {
      profileMessage.textContent = profileForm.dataset.error ?? 'Your profile could not be saved. Please try again.';
    } finally {
      profileForm.removeAttribute('aria-busy');
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  @import '../../styles/account.css';
</style>
