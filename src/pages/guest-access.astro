---
import ArrowIcon from '../components/ArrowIcon.astro';
import Base from '../layouts/Base.astro';
import { getGuestAccessEmail } from '../lib/guest-access';
import { localeHref, t } from '../lib/i18n';

const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
const token = Astro.url.searchParams.get('token') ?? '';
const validTokenShape = /^[A-Za-z0-9_-]{43}$/.test(token);
const email = await getGuestAccessEmail(Astro.cookies.get('iftiin_guest_access')?.value);
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---
<Base title={copy('guest.accessTitle')}>
  <section class="interior-hero wrap guest-access">
    <div class="section-label">{copy('guest.accessLabel')}</div>
    {email
      ? <>
          <h1>{copy('guest.signedIn')}</h1>
          <p>{copy('guest.libraryConnected')} {email}.</p>
          <a class="pill-link" href={localeHref('/guest-library/', locale)}>{copy('guest.toLibrary')} <ArrowIcon /></a>
        </>
      : validTokenShape
        ? <>
            <h1>{copy('guest.openAccess')}</h1>
            <p>{copy('guest.linkExpiry')}</p>
            <form id="redeem-form" data-token={token}>
              <button class="pill-link" type="submit">{copy('guest.openLibrary')} <ArrowIcon /></button>
              <p class="form-message" id="redeem-message" role="status" aria-live="polite"></p>
            </form>
          </>
        : <>
            <h1>{copy('guest.requestAccess')}</h1>
            <p>{copy('guest.emailForPurchase')}</p>
            <form id="request-form">
              <label for="guest-email">{copy('auth.email')}</label>
              <input id="guest-email" name="email" type="email" autocomplete="email" maxlength="254" required />
              <button class="pill-link" type="submit">{copy('guest.sendLink')} <ArrowIcon /></button>
              <p class="form-message" id="request-message" role="status" aria-live="polite"></p>
            </form>
          </>}
  </section>
</Base>

<script>
  const redeemForm = document.querySelector<HTMLFormElement>('#redeem-form');
  const redeemMessage = document.querySelector<HTMLElement>('#redeem-message');
  const locale = document.documentElement.lang;
  redeemForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const token = redeemForm.dataset.token;
    if (!token || !redeemMessage) return;
    redeemMessage.textContent = locale === 'en' ? 'Checking access …' : 'Zugang wird geprüft …';
    try {
      const response = await fetch('/api/guest-access/redeem/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token }),
      });
      const result = await response.json() as { redirectUrl?: string; error?: string };
      if (!response.ok || !result.redirectUrl) {
        throw new Error(locale === 'en' ? 'Could not open your access. The link may have expired; request a new one.' : result.error ?? 'Der Zugang konnte nicht geöffnet werden.');
      }
      const redirectUrl = new URL(result.redirectUrl, window.location.origin);
      redirectUrl.searchParams.set('lang', locale);
      window.location.assign(redirectUrl);
    } catch (error) {
      redeemMessage.textContent = error instanceof Error ? error.message : locale === 'en' ? 'Could not open your access.' : 'Der Zugang konnte nicht geöffnet werden.';
    }
  });

  const requestForm = document.querySelector<HTMLFormElement>('#request-form');
  const requestMessage = document.querySelector<HTMLElement>('#request-message');
  requestForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!requestForm || !requestMessage) return;
    requestMessage.textContent = locale === 'en' ? 'Requesting access link …' : 'Zugangslink wird angefordert …';
    try {
      const response = await fetch('/api/guest-access/request/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: new FormData(requestForm).get('email') }),
      });
      const result = await response.json() as { message?: string; error?: string };
      if (!response.ok) throw new Error(locale === 'en' ? 'The request could not be completed. Please check the address and try again.' : result.error ?? 'Die Anfrage ist fehlgeschlagen.');
      requestMessage.textContent = locale === 'en'
        ? 'If a purchase is associated with this address, you will receive a link.'
        : result.message ?? 'Wenn ein Kauf zu dieser Adresse gehört, erhältst du einen Link.';
    } catch (error) {
      requestMessage.textContent = error instanceof Error ? error.message : locale === 'en' ? 'The request failed.' : 'Die Anfrage ist fehlgeschlagen.';
    }
  });
</script>

<style>
  .guest-access { max-width: 760px; min-height: 55vh; padding-top: 5rem; }
  .guest-access form { display: grid; max-width: 420px; gap: .75rem; margin-top: 2rem; }
  .guest-access input { min-height: 44px; padding: .6rem .75rem; border: 1px solid var(--line); border-radius: 8px; background: transparent; color: inherit; font: inherit; }
  .guest-access button { justify-self: start; }
</style>
