---
import ArrowIcon from '../components/ArrowIcon.astro';
import Base from '../layouts/Base.astro';
import { randomUUID } from 'node:crypto';
import { localeHref, t } from '../lib/i18n';

const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
const inquiryHref = '#studio-inquiry-form';
const siteRoot = import.meta.env.BASE_URL.replace(/\/$/, '/');
const privacyHref = localeHref(`${siteRoot}datenschutz/`, locale);
const steps = [
  { title: copy('studio.stepDiscover'), body: copy('studio.stepDiscoverBody') },
  { title: copy('studio.stepReimagine'), body: copy('studio.stepReimagineBody') },
  { title: copy('studio.stepCreate'), body: copy('studio.stepCreateBody') },
  { title: copy('studio.stepOwn'), body: copy('studio.stepOwnBody') },
];
const takeaways = [
  copy('studio.takeaway1'),
  copy('studio.takeaway2'),
  copy('studio.takeaway3'),
  copy('studio.takeaway4'),
  copy('studio.takeaway5'),
];
const experiences = [
  {
    id: 'content',
    title: copy('studio.exampleContentTitle'),
    tools: ['ChatGPT', 'Claude', 'Notion', 'Canva'],
    outcome: copy('studio.exampleContentOutcome'),
    challenge: copy('studio.exampleContentChallenge'),
    explore: copy('studio.exampleContentExplore'),
    create: copy('studio.exampleContentCreate'),
    workflow: [
      copy('studio.workflowIdeas'),
      copy('studio.workflowAI'),
      copy('studio.workflowContent'),
    ],
  },
  {
    id: 'research',
    title: copy('studio.exampleResearchTitle'),
    tools: ['NotebookLM', 'Perplexity', 'ChatGPT', 'Obsidian'],
    outcome: copy('studio.exampleResearchOutcome'),
    challenge: copy('studio.exampleResearchChallenge'),
    explore: copy('studio.exampleResearchExplore'),
    create: copy('studio.exampleResearchCreate'),
    workflow: [
      copy('studio.workflowSources'),
      copy('studio.workflowSynthesis'),
      copy('studio.workflowInsights'),
    ],
  },
  {
    id: 'business',
    title: copy('studio.exampleBusinessTitle'),
    tools: ['ChatGPT', 'Claude', 'Canva'],
    outcome: copy('studio.exampleBusinessOutcome'),
    challenge: copy('studio.exampleBusinessChallenge'),
    explore: copy('studio.exampleBusinessExplore'),
    create: copy('studio.exampleBusinessCreate'),
    workflow: [
      copy('studio.workflowBusiness'),
      copy('studio.workflowReimagine'),
      copy('studio.workflowNewValue'),
    ],
  },
];
const format = [
  copy('studio.format1'),
  copy('studio.format2'),
  copy('studio.format3'),
  copy('studio.format4'),
  copy('studio.format5'),
];
const backgroundOptions = [
  ['independent_professional', 'studioInquiry.backgroundIndependent'],
  ['founder', 'studioInquiry.backgroundFounder'],
  ['small_business', 'studioInquiry.backgroundSmallBusiness'],
  ['creator_educator', 'studioInquiry.backgroundCreator'],
  ['other', 'studioInquiry.backgroundOther'],
] as const;
const challengeOptions = [
  ['communication_content', 'studioInquiry.challengeCommunication'],
  ['research_knowledge', 'studioInquiry.challengeResearch'],
  ['planning_organization', 'studioInquiry.challengePlanning'],
  ['creativity_ideas', 'studioInquiry.challengeCreativity'],
  ['business_reinvention', 'studioInquiry.challengeReinvention'],
  ['other_unsure', 'studioInquiry.challengeOther'],
] as const;
const outcomeOptions = [
  ['redesign_work', 'studioInquiry.outcomeRedesign'],
  ['create_ai_assistant', 'studioInquiry.outcomeAssistant'],
  ['reduce_repetitive_work', 'studioInquiry.outcomeRepetitive'],
  ['develop_ai_skills', 'studioInquiry.outcomeSkills'],
  ['explore_possibilities', 'studioInquiry.outcomeExplore'],
] as const;
const aiExperienceOptions = [
  ['beginner', 'studioInquiry.aiBeginner'],
  ['occasional', 'studioInquiry.aiOccasional'],
  ['regular', 'studioInquiry.aiRegular'],
] as const;
---

<Base title={copy('studio.metaTitle')} description={copy('studio.metaDescription')}>
  <nav class="studio-page-nav" aria-label={copy('home.navLabel')}>
    <a href="#studio-process"><span>01</span> {copy('studio.navProcess')}</a>
    <a href="#studio-outcomes"><span>02</span> {copy('studio.navOutcomes')}</a>
    <a href="#studio-experiences"><span>03</span> {copy('studio.navExperiences')}</a>
    <a href="#studio-format"><span>04</span> {copy('studio.navFormat')}</a>
    <a href="#studio-inquiry"><span>05</span> {copy('studio.navInquiry')}</a>
  </nav>

  <section class="studio-hero wrap" aria-labelledby="studio-title">
    <div class="section-label">{copy('studio.eyebrow')}</div>
    <h1 id="studio-title">{copy('studio.title')}</h1>
    <p class="studio-subtitle">{copy('studio.subtitle')}</p>
    <p class="studio-intro">{copy('studio.description')}</p>
    <a class="pill-link" href={inquiryHref}>{copy('studio.cta')} <ArrowIcon /></a>
  </section>

  <section class="studio-experience dark-section" id="studio-process" aria-labelledby="studio-experience-title">
    <div class="wrap">
      <div class="section-label light">{copy('studio.eyebrow')}</div>
      <h2 id="studio-experience-title">{copy('studio.experienceTitle')}</h2>
      <ol class="studio-steps" aria-label={copy('studio.stepsLabel')}>
        {steps.map((step, index) => <li>
          <span class="studio-step-number">{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>)}
      </ol>
    </div>
  </section>

  <section class="section wrap studio-takeaways" id="studio-outcomes" aria-labelledby="studio-takeaways-title">
    <div class="section-label">{copy('studio.eyebrow')}</div>
    <h2 id="studio-takeaways-title">{copy('studio.takeawaysTitle')}</h2>
    <ul>
      {takeaways.map((item) => <li><ArrowIcon size={16} />{item}</li>)}
    </ul>
  </section>

  <section class="studio-examples" id="studio-experiences" aria-labelledby="studio-examples-title">
    <div class="wrap">
      <header class="studio-experiences-header">
        <div>
          <div class="section-label">{copy('studio.eyebrow')}</div>
          <h2 id="studio-examples-title">{copy('studio.examplesTitle')}</h2>
        </div>
      </header>
      <div class="studio-examples-grid">
        {experiences.map((experience, index) => <article
          class:list={['studio-experience-card', `studio-experience-card--${experience.id}`]}
          aria-label={experience.title}
          data-experience-card
        >
          <div class="studio-experience-card-inner">
            <div
              class="studio-experience-face studio-experience-card-front"
              id={`studio-experience-${experience.id}-front`}
              data-experience-front
              aria-hidden="false"
            >
              <div class="studio-experience-card-topline">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <span>{copy('studio.experienceLabel')}</span>
              </div>
              <h3 id={`studio-experience-${experience.id}-title`}>{experience.title}</h3>
              <div class="studio-experience-tools">
                <span class="studio-experience-card-label">{copy('studio.toolsLabel')}</span>
                <ul>{experience.tools.map((tool) => <li>{tool}</li>)}</ul>
              </div>
              <div class="studio-experience-workflow">
                <span class="studio-experience-card-label">{copy('studio.workflowLabel')}</span>
                <ol aria-label={copy('studio.workflowLabel')}>
                  {experience.workflow.map((step) => <li>{step}</li>)}
                </ol>
              </div>
              <div class="studio-experience-outcome">
                <span>{copy('studio.outcomeLabel')}</span>
                <strong>{experience.outcome}</strong>
              </div>
              <button
                class="studio-experience-flip-button"
                type="button"
                data-flip-to-back
                aria-controls={`studio-experience-${experience.id}-back`}
                aria-expanded="false"
              >
                <span>{copy('studio.flipOpen')}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M4 7v5h5M20 17v-5h-5M5 12a7 7 0 0 1 12-4l2 2M19 12a7 7 0 0 1-12 4l-2-2" />
                </svg>
              </button>
            </div>
            <div
              class="studio-experience-face studio-experience-card-back"
              id={`studio-experience-${experience.id}-back`}
              data-experience-back
              aria-hidden="true"
              inert
            >
              <div class="studio-experience-card-topline">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <span>{copy('studio.experienceLabel')}</span>
              </div>
              <h3>{experience.title}</h3>
              <dl class="studio-experience-details">
                <div>
                  <dt>{copy('studio.flipChallenge')}</dt>
                  <dd>{experience.challenge}</dd>
                </div>
                <div>
                  <dt>{copy('studio.flipExplore')}</dt>
                  <dd>{experience.explore}</dd>
                </div>
                <div>
                  <dt>{copy('studio.flipCreate')}</dt>
                  <dd>{experience.create}</dd>
                </div>
              </dl>
              <button
                class="studio-experience-flip-button studio-experience-flip-button--back"
                type="button"
                data-flip-to-front
                aria-controls={`studio-experience-${experience.id}-front`}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M19 12H5M12 19l-7-7 7-7" />
                </svg>
                <span>{copy('studio.flipClose')}</span>
              </button>
            </div>
          </div>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section wrap studio-details" id="studio-format">
    <div>
      <h2 class="section-label">{copy('studio.formatTitle')}</h2>
      <ul class="studio-format-list">
        {format.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class="studio-scope">
      <h2 class="section-label">{copy('studio.scopeTitle')}</h2>
      <p>{copy('studio.scopeIntro')}</p>
      <p>{copy('studio.scopeLimitations')}</p>
    </div>
  </section>

  <section class="studio-final dark-section" aria-labelledby="studio-final-title">
    <div class="wrap">
      <div class="section-label light">{copy('studio.eyebrow')}</div>
      <h2 id="studio-final-title">{copy('studio.ctaTitle')}</h2>
      <p>{copy('studio.ctaDescription')}</p>
      <a class="pill-link" href={inquiryHref}>{copy('studio.cta')} <ArrowIcon /></a>
    </div>
  </section>

  <section class="studio-inquiry" id="studio-inquiry" aria-labelledby="studio-inquiry-title">
    <div class="wrap studio-inquiry-grid">
      <div class="studio-inquiry-intro">
        <div class="section-label">{copy('studioInquiry.eyebrow')}</div>
        <h2 id="studio-inquiry-title">{copy('studioInquiry.title')}</h2>
        <p>{copy('studioInquiry.intro')}</p>
      </div>
      <form
        class="studio-inquiry-form"
        id="studio-inquiry-form"
        data-endpoint={`${siteRoot}api/studio-inquiries/`}
        data-required-message={copy('studioInquiry.requiredError')}
        data-email-message={copy('studioInquiry.emailError')}
        data-invalid-message={copy('studioInquiry.invalid')}
        data-network-message={copy('studioInquiry.networkError')}
        data-success-message={copy('studioInquiry.success')}
        data-storage-message={copy('studioInquiry.storageError')}
        data-saved-but-draft-remains={copy('studioInquiry.savedButDraftRemains')}
        data-sending-label={copy('studioInquiry.sending')}
        data-submit-label={copy('studioInquiry.submit')}
        novalidate
      >
        <input type="hidden" name="submissionId" value={randomUUID()} />
        <label class="studio-honeypot" aria-hidden="true">
          {copy('studioInquiry.honeypot')}
          <input name="companyWebsite" tabindex="-1" autocomplete="off" />
        </label>

        <fieldset>
          <legend>{copy('studioInquiry.background')} <span>{copy('studioInquiry.required')}</span></legend>
          <select name="professionalBackground" required aria-describedby="studio-inquiry-error-professionalBackground">
            <option value="">—</option>
            {backgroundOptions.map(([value, key]) => <option value={value}>{copy(key)}</option>)}
          </select>
          <span class="studio-field-error" id="studio-inquiry-error-professionalBackground"></span>
        </fieldset>

        <fieldset>
          <legend>{copy('studioInquiry.challenge')} <span>{copy('studioInquiry.required')}</span></legend>
          <select name="challengeCategory" required aria-describedby="studio-inquiry-error-challengeCategory">
            <option value="">—</option>
            {challengeOptions.map(([value, key]) => <option value={value}>{copy(key)}</option>)}
          </select>
          <span class="studio-field-error" id="studio-inquiry-error-challengeCategory"></span>
        </fieldset>

        <fieldset>
          <legend>{copy('studioInquiry.outcome')} <span>{copy('studioInquiry.required')}</span></legend>
          <select name="desiredOutcome" required aria-describedby="studio-inquiry-error-desiredOutcome">
            <option value="">—</option>
            {outcomeOptions.map(([value, key]) => <option value={value}>{copy(key)}</option>)}
          </select>
          <span class="studio-field-error" id="studio-inquiry-error-desiredOutcome"></span>
        </fieldset>

        <fieldset>
          <legend>{copy('studioInquiry.aiExperience')} <span>{copy('studioInquiry.required')}</span></legend>
          <div class="studio-option-list">
            {aiExperienceOptions.map(([value, key]) => <label>
              <input type="radio" name="aiExperience" value={value} required aria-describedby="studio-inquiry-error-aiExperience" />
              <span>{copy(key)}</span>
            </label>)}
          </div>
          <span class="studio-field-error" id="studio-inquiry-error-aiExperience"></span>
        </fieldset>

        <div class="studio-inquiry-columns">
          <label>
            {copy('studioInquiry.timeline')}<span class="studio-field-meta">{copy('studioInquiry.optional')}</span>
            <select name="timeline">
              <option value="">—</option>
              <option value="within_2_weeks">{copy('studioInquiry.timelineTwoWeeks')}</option>
              <option value="within_1_month">{copy('studioInquiry.timelineMonth')}</option>
              <option value="within_3_months">{copy('studioInquiry.timelineQuarter')}</option>
              <option value="exploring">{copy('studioInquiry.timelineExplore')}</option>
            </select>
          </label>
          <label>
            {copy('studioInquiry.budget')}<span class="studio-field-meta">{copy('studioInquiry.optional')}</span>
            <select name="budgetRange">
              <option value="">—</option>
              <option value="under_500">{copy('studioInquiry.budgetUnder500')}</option>
              <option value="500_1500">{copy('studioInquiry.budget5001500')}</option>
              <option value="1500_3000">{copy('studioInquiry.budget15003000')}</option>
              <option value="over_3000">{copy('studioInquiry.budgetOver3000')}</option>
              <option value="unsure">{copy('studioInquiry.budgetUnsure')}</option>
            </select>
          </label>
        </div>

        <label>
          {copy('studioInquiry.details')}<span class="studio-field-meta">{copy('studioInquiry.optional')}</span>
          <textarea name="additionalDetails" maxlength="2000" rows="5" placeholder={copy('studioInquiry.detailsPlaceholder')}></textarea>
        </label>
        <div class="studio-inquiry-columns">
          <label>
            {copy('studioInquiry.name')}<span class="studio-field-meta">{copy('studioInquiry.required')}</span>
            <input name="fullName" type="text" maxlength="120" autocomplete="name" required aria-describedby="studio-inquiry-error-fullName" />
            <span class="studio-field-error" id="studio-inquiry-error-fullName"></span>
          </label>
          <label>
            {copy('studioInquiry.email')}<span class="studio-field-meta">{copy('studioInquiry.required')}</span>
            <input name="email" type="email" maxlength="254" autocomplete="email" required aria-describedby="studio-inquiry-error-email" />
            <span class="studio-field-error" id="studio-inquiry-error-email"></span>
          </label>
        </div>
        <p class="studio-inquiry-privacy">{copy('studioInquiry.privacyBefore')} <a href={privacyHref}>{copy('studioInquiry.privacyLink')}</a>.</p>
        <p id="studio-inquiry-status" class="studio-inquiry-status" role="status" aria-live="polite" tabindex="-1"></p>
        <button class="pill-link" type="submit">{copy('studioInquiry.submit')} <ArrowIcon /></button>
      </form>
    </div>
  </section>
</Base>

<script>
  const experienceCards = Array.from(document.querySelectorAll<HTMLElement>('[data-experience-card]'));

  function setExperienceCardFlipped(card: HTMLElement, flipped: boolean) {
    const front = card.querySelector<HTMLElement>('[data-experience-front]');
    const back = card.querySelector<HTMLElement>('[data-experience-back]');
    const frontButton = front?.querySelector<HTMLButtonElement>('[data-flip-to-back]');
    if (!front || !back || !frontButton) {
      throw new Error('Studio experience card is missing required flip controls.');
    }

    card.classList.toggle('is-flipped', flipped);
    front.setAttribute('aria-hidden', String(flipped));
    front.toggleAttribute('inert', flipped);
    back.setAttribute('aria-hidden', String(!flipped));
    back.toggleAttribute('inert', !flipped);
    frontButton.setAttribute('aria-expanded', String(flipped));
  }

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>('[data-flip-to-back], [data-flip-to-front]');
    const card = button?.closest<HTMLElement>('[data-experience-card]');
    if (!button || !card || !experienceCards.includes(card)) return;

    const flipped = button.hasAttribute('data-flip-to-back');
    if (flipped) experienceCards.forEach((item) => setExperienceCardFlipped(item, item === card));
    else setExperienceCardFlipped(card, false);

    const focusTarget = card.querySelector<HTMLButtonElement>(
      flipped ? '[data-flip-to-front]' : '[data-flip-to-back]',
    );
    if (!focusTarget) throw new Error('Studio experience card is missing its focus target.');
    focusTarget.focus();
  });

  const form = document.querySelector<HTMLFormElement>('#studio-inquiry-form');
  const status = document.querySelector<HTMLElement>('#studio-inquiry-status');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submissionId = form?.querySelector<HTMLInputElement>('input[name="submissionId"]');
  const submitLabelMarkup = submitButton?.innerHTML ?? '';
  const draftKey = 'iftiin-studio-inquiry-draft';
  const draftFieldNames = [
    'professionalBackground',
    'challengeCategory',
    'desiredOutcome',
    'aiExperience',
    'timeline',
    'budgetRange',
    'additionalDetails',
    'fullName',
    'email',
  ];
  const requiredNames = ['professionalBackground', 'challengeCategory', 'desiredOutcome', 'aiExperience', 'fullName', 'email'];

  function showStatus(message: string, isError = false) {
    if (!status) return;
    status.textContent = message;
    status.setAttribute('role', isError ? 'alert' : 'status');
  }

  function isRecord(value: unknown): value is Record<string, unknown> {
    return typeof value === 'object' && value !== null;
  }

  function saveDraft(): boolean {
    if (!form) return false;
    const data: Record<string, string> = {};
    for (const name of draftFieldNames) {
      const selectedRadio = form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
      if (selectedRadio) {
        data[name] = selectedRadio.value;
        continue;
      }
      const field = form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`);
      if (field) data[name] = field.value;
    }
    try {
      sessionStorage.setItem(draftKey, JSON.stringify({ savedAt: Date.now(), data }));
      return true;
    } catch {
      showStatus(form.dataset.storageMessage ?? '', true);
      return false;
    }
  }

  function restoreDraft() {
    if (!form) return;
    try {
      const rawDraft = sessionStorage.getItem(draftKey);
      if (!rawDraft) return;
      const draft: unknown = JSON.parse(rawDraft);
      if (!isRecord(draft) || typeof draft.savedAt !== 'number' || !isRecord(draft.data)) return;
      if (Date.now() - draft.savedAt > 60 * 60 * 1000) {
        sessionStorage.removeItem(draftKey);
        return;
      }
      for (const name of draftFieldNames) {
        const value = draft.data[name];
        if (typeof value !== 'string') continue;
        const radios = form.querySelectorAll<HTMLInputElement>(`input[type="radio"][name="${name}"]`);
        if (radios.length) {
          radios.forEach((radio) => { radio.checked = radio.value === value; });
        } else {
          const field = form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(`[name="${name}"]`);
          if (field) field.value = value;
        }
      }
    } catch {
      showStatus(form.dataset.storageMessage ?? '', true);
    }
  }

  function clearFieldError(name: string) {
    const error = document.getElementById(`studio-inquiry-error-${name}`);
    if (error) error.textContent = '';
    form?.querySelectorAll(`[name="${name}"]`).forEach((field) => field.removeAttribute('aria-invalid'));
  }

  function showFieldError(name: string, message: string) {
    const error = document.getElementById(`studio-inquiry-error-${name}`);
    if (error) error.textContent = message;
    form?.querySelectorAll(`[name="${name}"]`).forEach((field) => field.setAttribute('aria-invalid', 'true'));
  }

  function validateForm(): boolean {
    if (!form) return false;
    for (const name of requiredNames) clearFieldError(name);
    let firstInvalid: HTMLElement | null = null;
    for (const name of requiredNames) {
      const selectedRadio = form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
      const field = form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`);
      const value = selectedRadio?.value ?? field?.value.trim() ?? '';
      if (!value) {
        showFieldError(name, form.dataset.requiredMessage ?? '');
        firstInvalid ??= selectedRadio ?? field;
      } else if (name === 'email' && field instanceof HTMLInputElement && field.validity.typeMismatch) {
        showFieldError(name, form.dataset.emailMessage ?? '');
        firstInvalid ??= field;
      }
    }
    if (firstInvalid) {
      showStatus(form.dataset.invalidMessage ?? '', true);
      firstInvalid.focus();
      return false;
    }
    return true;
  }

  restoreDraft();
  form?.addEventListener('input', () => { saveDraft(); });
  form?.addEventListener('change', () => { saveDraft(); });
  document.querySelectorAll<HTMLAnchorElement>('.language-switch a').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (!saveDraft()) event.preventDefault();
    });
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!validateForm() || !form || !submitButton) return;

    const data = new FormData(form);
    const payload = {
      submissionId: String(data.get('submissionId') ?? ''),
      professionalBackground: String(data.get('professionalBackground') ?? ''),
      challengeCategory: String(data.get('challengeCategory') ?? ''),
      desiredOutcome: String(data.get('desiredOutcome') ?? ''),
      aiExperience: String(data.get('aiExperience') ?? ''),
      timeline: String(data.get('timeline') ?? '') || null,
      budgetRange: String(data.get('budgetRange') ?? '') || null,
      additionalDetails: String(data.get('additionalDetails') ?? '').trim() || null,
      fullName: String(data.get('fullName') ?? '').trim(),
      email: String(data.get('email') ?? '').trim(),
      companyWebsite: String(data.get('companyWebsite') ?? ''),
    };

    form.setAttribute('aria-busy', 'true');
    submitButton.disabled = true;
    submitButton.textContent = form.dataset.sendingLabel ?? '';
    showStatus('');
    try {
      const response = await fetch(form.dataset.endpoint ?? '', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const result = await response.json() as { success?: boolean; error?: string; fields?: string[] };
      if (!response.ok || !result.success) {
        if (result.fields) {
          for (const name of result.fields) {
            if (draftFieldNames.includes(name)) showFieldError(name, form.dataset.invalidMessage ?? '');
          }
        }
        showStatus(result.error ?? form.dataset.networkMessage ?? '', true);
        return;
      }
      form.reset();
      if (submissionId) submissionId.value = crypto.randomUUID();
      let draftCleared = true;
      try {
        sessionStorage.removeItem(draftKey);
      } catch {
        draftCleared = false;
      }
      showStatus(`${form.dataset.successMessage ?? ''}${draftCleared ? '' : form.dataset.savedButDraftRemains ?? ''}`, !draftCleared);
      status?.focus();
    } catch {
      showStatus(form.dataset.networkMessage ?? '', true);
    } finally {
      form.removeAttribute('aria-busy');
      submitButton.disabled = false;
      submitButton.innerHTML = submitLabelMarkup;
    }
  });
</script>

