---
import ArrowIcon from '../../components/ArrowIcon.astro';
import Base from '../../layouts/Base.astro';
import { getSessionAccount } from '../../lib/auth';
import { allArticles } from '../../lib/articles';
import { listAdminProducts } from '../../lib/commerce';
import { query } from '../../lib/db';
import { getStudioInquiryCounts } from '../../lib/studio-inquiries';
import { getWaitlistCounts } from '../../lib/skills-navigator-waitlist';

const account = await getSessionAccount(Astro.cookies.get('iftiin_session')?.value);
if (!account) return Astro.redirect('/login/', 302);
if (account.role !== 'admin') return Astro.redirect('/account/', 302);

const root = (path = '') => import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//, '');
const [articles, products, inquiryCounts, waitlistCounts, contentResult] = await Promise.all([
  allArticles(),
  listAdminProducts(),
  getStudioInquiryCounts(),
  getWaitlistCounts(),
  query<{ total: string; published: string; draft: string; archived: string }>(
    `SELECT COUNT(*)::text AS total,
       COUNT(*) FILTER (WHERE status = 'published')::text AS published,
       COUNT(*) FILTER (WHERE status = 'draft')::text AS draft,
       COUNT(*) FILTER (WHERE status = 'archived')::text AS archived
     FROM content_items`,
  ),
]);
const contentCounts = contentResult.rows[0];
const activeProducts = products.filter((product) => product.status === 'active').length;
const draftProducts = products.filter((product) => product.status === 'draft').length;
const uncategorizedActive = products.filter((product) => product.status === 'active' && !product.storeCategory).length;
---

<Base title="Admin-Dashboard">
  <section class="section wrap admin-layout admin-dashboard">
    <div class="section-label">Admin / Übersicht</div>
    <h1>Alles <em>im Blick.</em></h1>
    <p>Verwalte Redaktion, Shop, Anfragen und Pilotanmeldungen an einem Ort. Über die Bereiche gelangst du direkt zu den vorhandenen Einstellungen und Bearbeitungsseiten.</p>

    <div class="dashboard-grid">
      <article class="dashboard-card">
        <p class="dashboard-kicker">Redaktion</p>
        <h2>Artikel</h2>
        <p class="dashboard-total">{articles.length} Beiträge insgesamt</p>
        <dl class="dashboard-stats">
          <div><dt>Veröffentlicht</dt><dd>{articles.filter((article) => article.data.status === 'published').length}</dd></div>
          <div><dt>Entwürfe</dt><dd>{articles.filter((article) => article.data.status === 'draft').length}</dd></div>
        </dl>
        <a class="pill-link" href={root('admin/articles/')}>Artikel verwalten <ArrowIcon /></a>
      </article>

      <article class="dashboard-card">
        <p class="dashboard-kicker">Redaktion</p>
        <h2>Inhalte</h2>
        <p class="dashboard-total">{contentCounts.total} Inhalte insgesamt</p>
        <dl class="dashboard-stats">
          <div><dt>Veröffentlicht</dt><dd>{contentCounts.published}</dd></div>
          <div><dt>Entwürfe</dt><dd>{contentCounts.draft}</dd></div>
          <div><dt>Archiviert</dt><dd>{contentCounts.archived}</dd></div>
        </dl>
        <a class="pill-link" href={root('admin/products/?tab=contents')}>Inhalte verwalten <ArrowIcon /></a>
      </article>

      <article class="dashboard-card">
        <p class="dashboard-kicker">Shop</p>
        <h2>Produkte &amp; Kategorien</h2>
        <p class="dashboard-total">{products.length} Produkte insgesamt</p>
        <dl class="dashboard-stats">
          <div><dt>Aktiv</dt><dd>{activeProducts}</dd></div>
          <div><dt>Entwürfe</dt><dd>{draftProducts}</dd></div>
        </dl>
        {uncategorizedActive > 0 && (
          <p class="dashboard-warning">{uncategorizedActive} aktive Produkte haben noch keine Kategorie.</p>
        )}
        <a class="pill-link" href={root('admin/products/?tab=products')}>Produkte einstellen <ArrowIcon /></a>
      </article>

      <article class="dashboard-card">
        <p class="dashboard-kicker">Skills Navigator</p>
        <h2>Pilotanmeldungen</h2>
        <p class="dashboard-total">{waitlistCounts.confirmed + waitlistCounts.pending} Anmeldungen insgesamt</p>
        <dl class="dashboard-stats">
          <div><dt>Bestätigt</dt><dd>{waitlistCounts.confirmed}</dd></div>
          <div><dt>Offen</dt><dd>{waitlistCounts.pending}</dd></div>
        </dl>
        <a class="pill-link" href={root('admin/skills-navigator-waitlist/')}>Pilot verwalten <ArrowIcon /></a>
      </article>

      <article class="dashboard-card">
        <p class="dashboard-kicker">Studio</p>
        <h2>Anfragen</h2>
        <p class="dashboard-total">{inquiryCounts.total} Anfragen insgesamt</p>
        <dl class="dashboard-stats">
          <div><dt>Neu</dt><dd>{inquiryCounts.new}</dd></div>
          <div><dt>Kontaktiert</dt><dd>{inquiryCounts.contacted}</dd></div>
          <div><dt>Qualifiziert</dt><dd>{inquiryCounts.qualified}</dd></div>
          <div><dt>Abgeschlossen</dt><dd>{inquiryCounts.closed}</dd></div>
        </dl>
        <a class="pill-link" href={root('admin/studio-inquiries/')}>Anfragen verwalten <ArrowIcon /></a>
      </article>
    </div>
  </section>
</Base>

<style>
  .dashboard-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px;margin-top:38px}
  .dashboard-card{display:flex;flex-direction:column;align-items:flex-start;min-width:0;padding:24px;background:var(--paper);border:1px solid var(--line)}
  .dashboard-kicker{margin:0 0 12px;color:var(--muted);font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .dashboard-card h2{margin:0;font-size:clamp(22px,2.4vw,30px)}
  .dashboard-total{margin:10px 0 0;color:var(--muted);font-size:14px}
  .dashboard-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 18px;width:100%;margin:22px 0}
  .dashboard-stats div{display:grid;gap:4px}
  .dashboard-stats dt{color:var(--muted);font-size:12px}
  .dashboard-stats dd{margin:0;font-size:24px;font-weight:700}
  .dashboard-warning{width:100%;margin:0 0 18px;padding:12px;background:color-mix(in srgb,var(--yellow) 35%,transparent);font-size:13px}
  .dashboard-card .pill-link{margin-top:auto}
  @media(max-width:600px){.dashboard-grid{grid-template-columns:1fr}.dashboard-card{padding:20px}}
</style>
