---
import Base from '../../layouts/Base.astro';
import { getSessionAccount } from '../../lib/auth';
import { isCheckoutConfigured } from '../../lib/stripe';

const account = await getSessionAccount(Astro.cookies.get('iftiin_session')?.value);
if (!account) return Astro.redirect('/login/', 302);
if (account.role !== 'admin') return Astro.redirect('/account/', 302);
const root = (path = '') => import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//, '');
---
<Base title="CMS verwalten">
  <section class="cms-admin" data-api-root={root('api/admin/')} data-site-root={root()}>
    <header class="cms-header">
      <a class="cms-brand" href={root('admin/')} aria-label="Zur Artikelverwaltung">iftiin <span>flow.</span> / CMS</a>
      <nav aria-label="Admin-Navigation">
        <a href={root('admin/')}>Redaktion</a>
        <a href={root('admin/products/')} aria-current="page">Inhalte &amp; Produkte</a>
        <a href={root('')}>Website ansehen ↗</a>
      </nav>
    </header>

    <main class="cms-main">
      <div class="cms-title-row">
        <div>
          <p class="cms-eyebrow">Admin / Verwaltung</p>
          <h1>Inhalte &amp; Produkte</h1>
        </div>
        <p id="cms-message" class="cms-message" role="status" aria-live="polite"></p>
      </div>

      <div class="cms-tabs" role="tablist" aria-label="Verwaltungsbereich">
        <button id="contents-tab" type="button" role="tab" aria-controls="contents-panel">Inhalte</button>
        <button id="products-tab" type="button" role="tab" aria-controls="products-panel">Produkte</button>
      </div>

      <section id="contents-panel" class="cms-panel" role="tabpanel" aria-labelledby="contents-tab">
        <div class="cms-panel-heading">
          <h2>Inhalte</h2>
          <button class="cms-button cms-button-primary" id="create-content" type="button">+ Inhalt erstellen</button>
        </div>
        <div class="cms-filters">
          <label>Suche Inhalte<input id="content-search" type="search" placeholder="Titel oder URL-Slug" /></label>
          <label>Status filtern
            <select id="content-status-filter">
              <option value="">Alle Status</option>
              <option value="draft">Entwurf</option>
              <option value="published">Veröffentlicht</option>
              <option value="archived">Archiviert</option>
            </select>
          </label>
        </div>
        <p id="content-empty" class="cms-empty" hidden>Keine Inhalte gefunden.</p>
        <div class="cms-table-wrap">
          <table>
            <thead><tr><th>Titel</th><th>Typ</th><th>Status</th><th>Aktionen</th></tr></thead>
            <tbody id="content-table"></tbody>
          </table>
        </div>
        <div id="content-cards" class="cms-cards"></div>
      </section>

      <section id="products-panel" class="cms-panel" role="tabpanel" aria-labelledby="products-tab" hidden>
        <div class="cms-panel-heading">
          <h2>Produkte</h2>
          <button class="cms-button cms-button-primary" id="create-product" type="button">+ Produkt erstellen</button>
        </div>
        <p class="cms-payment-note">
          {isCheckoutConfigured()
            ? 'Stripe Checkout ist konfiguriert. Einmalige Käufe und Membership-Abos werden über Stripe abgewickelt.'
            : 'Stripe Checkout bleibt deaktiviert, bis die Stripe-Einstellungen im Website-Service vollständig und sicher hinterlegt sind.'}
        </p>
        <div class="cms-filters">
          <label>Suche Produkte<input id="product-search" type="search" placeholder="Name oder URL-Slug" /></label>
          <label>Status filtern
            <select id="product-status-filter">
              <option value="">Alle Status</option>
              <option value="draft">Entwurf</option>
              <option value="active">Aktiv</option>
              <option value="archived">Archiviert</option>
            </select>
          </label>
        </div>
        <p id="product-empty" class="cms-empty" hidden>Keine Produkte gefunden.</p>
        <div class="cms-table-wrap">
          <table>
            <thead><tr><th>Name</th><th>Preis</th><th>Status</th><th>Aktionen</th></tr></thead>
            <tbody id="product-table"></tbody>
          </table>
        </div>
        <div id="product-cards" class="cms-cards"></div>
      </section>
    </main>

    <dialog id="content-editor" class="cms-dialog" aria-labelledby="content-editor-title">
      <form id="content-form" class="cms-editor-form">
        <header class="cms-editor-header">
          <div>
            <p class="cms-eyebrow">Inhalte</p>
            <h2 id="content-editor-title">Inhalt erstellen</h2>
          </div>
          <button type="button" class="cms-icon-button" data-close-editor aria-label="Editor schließen">×</button>
        </header>
        <input type="hidden" name="id" />
        <input type="hidden" name="storageAssetId" />
        <div class="cms-editor-body">
          <section class="cms-form-section">
            <h3>Grunddaten</h3>
            <div class="cms-form-grid">
              <label>Titel<input name="title" maxlength="180" required /></label>
              <label>Inhaltstyp
                <select name="contentType">
                  <option value="download">Digitaler Download</option>
                  <option value="lesson">Lektion</option>
                  <option value="video">Video</option>
                </select>
              </label>
              <label class="cms-field-wide">Kurzbeschreibung<textarea name="description" maxlength="1000" rows="2"></textarea></label>
            </div>
          </section>
          <section class="cms-form-section">
            <h3>Inhalt &amp; Datei</h3>
            <label>Inhalt / Lerntext<textarea name="body" maxlength="100000" rows="8"></textarea></label>
            <label>Datei (PDF, ZIP, MP4, WebM oder MOV; max. 500 MB)
              <input name="file" type="file" accept=".pdf,.zip,.mp4,.webm,.mov,application/pdf,application/zip,video/mp4,video/webm,video/quicktime" />
            </label>
            <p id="content-upload-status" class="cms-upload-status" role="status" aria-live="polite"></p>
          </section>
          <section class="cms-form-section">
            <h3>Veröffentlichung</h3>
            <div class="cms-form-grid">
              <label>Status<select name="status"><option value="draft">Entwurf</option><option value="published">Veröffentlicht</option><option value="archived">Archiviert</option></select></label>
              <label>Reihenfolge<input name="position" type="number" min="0" max="10000" value="0" required /></label>
            </div>
          </section>
          <section class="cms-form-section">
            <h3>URL-Einstellungen</h3>
            <label>URL-Slug<input name="slug" maxlength="120" pattern="[a-z0-9]+(-[a-z0-9]+)*" required /></label>
          </section>
        </div>
        <footer class="cms-editor-actions">
          <button type="button" class="cms-button cms-button-secondary" data-cancel-editor>Abbrechen</button>
          <button type="submit" class="cms-button cms-button-primary">Speichern</button>
        </footer>
      </form>
    </dialog>

    <dialog id="product-editor" class="cms-dialog" aria-labelledby="product-editor-title">
      <form id="product-form" class="cms-editor-form">
        <header class="cms-editor-header">
          <div>
            <p class="cms-eyebrow">Produkte</p>
            <h2 id="product-editor-title">Produkt erstellen</h2>
          </div>
          <button type="button" class="cms-icon-button" data-close-editor aria-label="Editor schließen">×</button>
        </header>
        <input type="hidden" name="id" />
        <input type="hidden" name="coverAssetId" />
        <div class="cms-editor-body">
          <section class="cms-form-section">
            <h3>Grunddaten</h3>
            <div class="cms-form-grid">
              <label>Name<input name="name" maxlength="180" required /></label>
              <label>Produkttyp
                <select name="productType">
                  <option value="digital_download">Digitaler Download</option>
                  <option value="premium_article">Premium-Artikel</option>
                  <option value="online_course">Online-Kurs</option>
                  <option value="bundle">Bundle</option>
                  <option value="membership">Membership</option>
                </select>
              </label>
              <label class="cms-field-wide">Beschreibung<textarea name="description" maxlength="2000" rows="3"></textarea></label>
            </div>
          </section>
          <section class="cms-form-section">
            <h3>Darstellung &amp; Preis</h3>
            <div class="cms-form-grid">
              <label class="cms-field-wide">Coverbild (optional, JPEG, PNG oder WebP; max. 10 MB)
                <input name="coverFile" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" />
              </label>
              <div id="cover-preview" class="cms-cover-preview cms-field-wide" hidden>
                <img id="cover-preview-image" alt="Produktcover-Vorschau" />
                <button class="cms-button cms-button-secondary" id="cover-remove" type="button">Cover entfernen</button>
              </div>
              <label>Preis in Euro<input name="price" type="number" min="0.50" max="1000000" step="0.01" required /></label>
              <label hidden>Abrechnung
                <select name="billingInterval">
                  <option value="one_time">Einmalig</option>
                  <option value="month">Monatliches Abo</option>
                  <option value="year">Jährliches Abo</option>
                </select>
              </label>
            </div>
            <p id="cover-upload-status" class="cms-upload-status" role="status" aria-live="polite"></p>
          </section>
          <section class="cms-form-section">
            <h3>Enthaltene Inhalte</h3>
            <label>Inhalte suchen<input id="linked-content-search" type="search" placeholder="Titel oder Typ" /></label>
            <div id="content-options" class="cms-content-options" aria-label="Enthaltene Inhalte auswählen"></div>
            <p id="selected-content-count" class="cms-hint">Keine Inhalte ausgewählt.</p>
          </section>
          <section class="cms-form-section">
            <h3>Veröffentlichung</h3>
            <div class="cms-form-grid">
              <label>Status<select name="status"><option value="draft">Entwurf</option><option value="active">Aktiv</option><option value="archived">Archiviert</option></select></label>
              <label class="cms-field-wide">URL-Slug<input name="slug" maxlength="120" pattern="[a-z0-9]+(-[a-z0-9]+)*" required /></label>
            </div>
          </section>
        </div>
        <footer class="cms-editor-actions">
          <button type="button" class="cms-button cms-button-secondary" data-cancel-editor>Abbrechen</button>
          <button type="submit" class="cms-button cms-button-primary">Speichern</button>
        </footer>
      </form>
    </dialog>

    <dialog id="delete-confirmation" class="cms-confirm-dialog" aria-labelledby="delete-title" aria-describedby="delete-description">
      <form method="dialog" id="delete-form">
        <h2 id="delete-title">Inhalt löschen?</h2>
        <p id="delete-description"></p>
        <div id="delete-blocked-products" class="cms-delete-products" hidden></div>
        <div class="cms-confirm-actions">
          <button type="submit" class="cms-button cms-button-secondary" value="cancel">Abbrechen</button>
          <button type="button" id="confirm-delete" class="cms-button cms-button-danger">Inhalt löschen</button>
        </div>
      </form>
    </dialog>
  </section>
</Base>

<script>
  type ContentRecord = {
    id: string; slug: string; title: string; description: string; body: string;
    contentType: string; status: string; storageAssetId: string | null;
    originalFilename: string | null; articleId: string | null; position: number;
  };
  type ProductRecord = {
    id: string; slug: string; name: string; description: string; productType: string;
    status: string; amountCents: number; billingInterval: 'one_time' | 'month' | 'year';
    coverAssetId: string | null;
    content: Pick<ContentRecord, 'id' | 'title' | 'contentType' | 'status'>[];
  };
  type UploadResponse = { id: string; uploadUrl: string; headers: Record<string, string> };
  type ApiError = Error & { products?: string[] };

  const cms = document.querySelector<HTMLElement>('.cms-admin');
  const root = cms?.dataset.apiRoot ?? '/api/admin/';
  const siteRoot = cms?.dataset.siteRoot ?? '/';
  const message = document.querySelector<HTMLElement>('#cms-message');
  const contentForm = document.querySelector<HTMLFormElement>('#content-form');
  const productForm = document.querySelector<HTMLFormElement>('#product-form');
  const contentDialog = document.querySelector<HTMLDialogElement>('#content-editor');
  const productDialog = document.querySelector<HTMLDialogElement>('#product-editor');
  const deleteDialog = document.querySelector<HTMLDialogElement>('#delete-confirmation');
  const contentTable = document.querySelector<HTMLTableSectionElement>('#content-table');
  const productTable = document.querySelector<HTMLTableSectionElement>('#product-table');
  const contentCards = document.querySelector<HTMLDivElement>('#content-cards');
  const productCards = document.querySelector<HTMLDivElement>('#product-cards');
  const contentOptions = document.querySelector<HTMLDivElement>('#content-options');
  const contentSearch = document.querySelector<HTMLInputElement>('#content-search');
  const productSearch = document.querySelector<HTMLInputElement>('#product-search');
  const contentStatusFilter = document.querySelector<HTMLSelectElement>('#content-status-filter');
  const productStatusFilter = document.querySelector<HTMLSelectElement>('#product-status-filter');
  const contentOptionSearch = document.querySelector<HTMLInputElement>('#linked-content-search');
  const contentUploadStatus = document.querySelector<HTMLElement>('#content-upload-status');
  const coverUploadStatus = document.querySelector<HTMLElement>('#cover-upload-status');
  const coverPreview = document.querySelector<HTMLDivElement>('#cover-preview');
  const coverPreviewImage = document.querySelector<HTMLImageElement>('#cover-preview-image');
  const contentEditorTitle = document.querySelector<HTMLElement>('#content-editor-title');
  const productEditorTitle = document.querySelector<HTMLElement>('#product-editor-title');
  const deleteDescription = document.querySelector<HTMLElement>('#delete-description');
  const deleteBlockedProducts = document.querySelector<HTMLDivElement>('#delete-blocked-products');
  const confirmDelete = document.querySelector<HTMLButtonElement>('#confirm-delete');
  const contentTypeNames: Record<string, string> = { download: 'Digitaler Download', lesson: 'Lektion', video: 'Video', article: 'Artikel' };
  const statusNames: Record<string, string> = { draft: 'Entwurf', published: 'Veröffentlicht', active: 'Aktiv', archived: 'Archiviert' };
  const stateKey = 'iftiin-cms-list-state';

  let contents: ContentRecord[] = [];
  let products: ProductRecord[] = [];
  let selectedForDeletion: ContentRecord | null = null;
  let selectedContentIds = new Set<string>();
  let saving = false;
  let dirty = false;
  let activeEditor: HTMLDialogElement | null = null;
  let coverObjectUrl: string | null = null;

  function report(text: string) {
    if (message) message.textContent = text;
  }
  for (const dialog of [contentDialog, productDialog]) {
    dialog?.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeEditor(dialog, dialog === contentDialog ? contentForm : productForm);
    });
  }
  function setDirty(value: boolean) {
    dirty = value;
  }
  function formField<T extends HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
    form: HTMLFormElement | null,
    name: string,
  ): T | null {
    return form?.elements.namedItem(name) as T | null;
  }
  async function api<T>(url: string, init?: RequestInit): Promise<T> {
    const response = await fetch(url, init);
    const result = await response.json() as T & { error?: string; products?: string[] };
    if (!response.ok) {
      const error = new Error(result.error ?? 'Die Anfrage konnte nicht verarbeitet werden.') as ApiError;
      error.products = result.products;
      throw error;
    }
    return result;
  }
  function statusLabel(status: string) {
    return statusNames[status] ?? status;
  }
  function setStatusBadge(element: HTMLElement, status: string) {
    element.className = `cms-status cms-status-${status}`;
    element.textContent = statusLabel(status);
  }
  function slugFromTitle(value: string) {
    return value.normalize('NFKD').replace(/ß/g, 'ss').replace(/[\u0300-\u036f]/g, '')
      .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 120).replace(/-+$/g, '');
  }
  function suggestSlug(form: HTMLFormElement | null, titleName: string) {
    const title = formField<HTMLInputElement>(form, titleName)?.value ?? '';
    const slug = formField<HTMLInputElement>(form, 'slug');
    if (slug && formField<HTMLInputElement>(form, 'id')?.value === '' && slug.dataset.manual !== 'true') {
      slug.value = slugFromTitle(title);
    }
  }
  function updateListState() {
    const selectedTab = document.querySelector<HTMLButtonElement>('[role="tab"][aria-selected="true"]')?.id === 'products-tab'
      ? 'products' : 'contents';
    const state = {
      selectedTab,
      contentSearch: contentSearch?.value ?? '',
      productSearch: productSearch?.value ?? '',
      contentStatus: contentStatusFilter?.value ?? '',
      productStatus: productStatusFilter?.value ?? '',
    };
    try { sessionStorage.setItem(stateKey, JSON.stringify(state)); } catch {}
  }
  function restoreListState() {
    try {
      const raw = sessionStorage.getItem(stateKey);
      if (!raw) return;
      const state = JSON.parse(raw) as {
        selectedTab?: string; contentSearch?: string; productSearch?: string;
        contentStatus?: string; productStatus?: string;
      };
      if (contentSearch) contentSearch.value = state.contentSearch ?? '';
      if (productSearch) productSearch.value = state.productSearch ?? '';
      if (contentStatusFilter) contentStatusFilter.value = state.contentStatus ?? '';
      if (productStatusFilter) productStatusFilter.value = state.productStatus ?? '';
      setActiveTab(state.selectedTab === 'products' ? 'products' : 'contents');
    } catch {
      sessionStorage.removeItem(stateKey);
    }
  }
  function setActiveTab(tab: 'contents' | 'products') {
    for (const [name, id] of [['contents', 'contents-tab'], ['products', 'products-tab']] as const) {
      const selected = name === tab;
      const button = document.getElementById(id);
      const panel = document.getElementById(`${name}-panel`);
      button?.setAttribute('aria-selected', String(selected));
      button?.setAttribute('tabindex', selected ? '0' : '-1');
      panel?.toggleAttribute('hidden', !selected);
    }
    updateListState();
  }
  function addActionMenu(
    id: string,
    itemType: 'content' | 'product',
    status: string,
    row: HTMLElement,
  ) {
    const details = document.createElement('details');
    details.className = 'cms-actions-menu';
    const summary = document.createElement('summary');
    summary.textContent = 'Weitere Aktionen';
    details.append(summary);
    if (status !== 'archived') {
      const archive = document.createElement('button');
      archive.type = 'button';
      archive.textContent = 'Archivieren';
      archive.addEventListener('click', async () => {
        details.open = false;
        const label = itemType === 'content'
          ? (contents.find((entry) => entry.id === id)?.title ?? 'Inhalt')
          : (products.find((entry) => entry.id === id)?.name ?? 'Produkt');
        if (!window.confirm(`„${label}“ archivieren?`)) return;
        try {
          if (itemType === 'content') {
            const item = contents.find((entry) => entry.id === id);
            if (!item) return;
            await api(`${root}content/${encodeURIComponent(id)}/`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ...item, status: 'archived' }),
            });
          } else {
            await api(`${root}products/${encodeURIComponent(id)}/`, { method: 'DELETE' });
          }
          await loadData('Eintrag archiviert.');
        } catch (error) {
          report(error instanceof Error ? error.message : 'Eintrag konnte nicht archiviert werden.');
        }
      });
      details.append(archive);
    }
    if (itemType === 'content') {
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = 'Löschen';
      remove.addEventListener('click', () => {
        details.open = false;
        const item = contents.find((entry) => entry.id === id);
        if (item) openDeleteDialog(item);
      });
      details.append(remove);
    }
    row.append(details);
  }
  function createActionCell(item: ContentRecord | ProductRecord, itemType: 'content' | 'product') {
    const cell = document.createElement('td');
    cell.className = 'cms-row-actions';
    const edit = document.createElement('button');
    edit.type = 'button';
    edit.className = 'cms-button cms-button-small cms-button-secondary';
    if (itemType === 'content' && (item as ContentRecord).articleId) {
      edit.textContent = 'Redaktion öffnen';
      edit.addEventListener('click', () => window.location.assign(`${siteRoot}admin/`));
      cell.append(edit);
      return cell;
    }
    edit.textContent = 'Bearbeiten';
    edit.addEventListener('click', () => itemType === 'content'
      ? openContentEditor(item as ContentRecord)
      : openProductEditor(item as ProductRecord));
    cell.append(edit);
    addActionMenu(item.id, itemType, item.status, cell);
    return cell;
  }
  function renderContent() {
    const needle = contentSearch?.value.trim().toLocaleLowerCase('de') ?? '';
    const status = contentStatusFilter?.value ?? '';
    const visible = contents.filter((item) =>
      (!status || item.status === status) &&
      (!needle || `${item.title} ${item.slug}`.toLocaleLowerCase('de').includes(needle)));
    if (contentTable) contentTable.replaceChildren();
    if (contentCards) contentCards.replaceChildren();
    for (const item of visible) {
      const row = document.createElement('tr');
      const title = document.createElement('th');
      title.scope = 'row';
      title.textContent = item.title;
      const type = document.createElement('td');
      type.textContent = contentTypeNames[item.contentType] ?? item.contentType;
      const statusCell = document.createElement('td');
      const badge = document.createElement('span');
      setStatusBadge(badge, item.status);
      statusCell.append(badge);
      row.append(title, type, statusCell, createActionCell(item, 'content'));
      contentTable?.append(row);

      const card = document.createElement('article');
      card.className = 'cms-card';
      const cardTitle = document.createElement('h3');
      cardTitle.textContent = item.title;
      const cardMeta = document.createElement('p');
      cardMeta.textContent = contentTypeNames[item.contentType] ?? item.contentType;
      const cardStatus = document.createElement('span');
      setStatusBadge(cardStatus, item.status);
      const cardActions = document.createElement('div');
      cardActions.className = 'cms-card-actions';
      const edit = createActionCell(item, 'content');
      cardActions.append(...Array.from(edit.children));
      card.append(cardTitle, cardMeta, cardStatus, cardActions);
      contentCards?.append(card);
    }
    document.querySelector<HTMLElement>('#content-empty')!.hidden = visible.length > 0;
    updateListState();
  }
  function renderProducts() {
    const needle = productSearch?.value.trim().toLocaleLowerCase('de') ?? '';
    const status = productStatusFilter?.value ?? '';
    const visible = products.filter((item) =>
      (!status || item.status === status) &&
      (!needle || `${item.name} ${item.slug}`.toLocaleLowerCase('de').includes(needle)));
    if (productTable) productTable.replaceChildren();
    if (productCards) productCards.replaceChildren();
    for (const item of visible) {
      const row = document.createElement('tr');
      const title = document.createElement('th');
      title.scope = 'row';
      title.textContent = item.name;
      const price = document.createElement('td');
      price.textContent = new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format(item.amountCents / 100);
      if (item.billingInterval !== 'one_time') {
        price.textContent += ` / ${item.billingInterval === 'month' ? 'Monat' : 'Jahr'}`;
      }
      const statusCell = document.createElement('td');
      const badge = document.createElement('span');
      setStatusBadge(badge, item.status);
      statusCell.append(badge);
      row.append(title, price, statusCell, createActionCell(item, 'product'));
      productTable?.append(row);

      const card = document.createElement('article');
      card.className = 'cms-card';
      const cardTitle = document.createElement('h3');
      cardTitle.textContent = item.name;
      const cardMeta = document.createElement('p');
      cardMeta.textContent = price.textContent;
      const cardStatus = document.createElement('span');
      setStatusBadge(cardStatus, item.status);
      const cardActions = document.createElement('div');
      cardActions.className = 'cms-card-actions';
      const edit = createActionCell(item, 'product');
      cardActions.append(...Array.from(edit.children));
      card.append(cardTitle, cardMeta, cardStatus, cardActions);
      productCards?.append(card);
    }
    document.querySelector<HTMLElement>('#product-empty')!.hidden = visible.length > 0;
    updateListState();
  }
  function renderContentOptions(selected: Set<string> = new Set()) {
    if (!contentOptions) return;
    const needle = contentOptionSearch?.value.trim().toLocaleLowerCase('de') ?? '';
    contentOptions.replaceChildren();
    for (const item of contents) {
      if (item.articleId === null && item.contentType === 'article') continue;
      if (needle && !`${item.title} ${item.contentType}`.toLocaleLowerCase('de').includes(needle)) continue;
      const label = document.createElement('label');
      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.name = 'contentIds';
      checkbox.value = item.id;
      checkbox.checked = selectedContentIds.has(item.id) || selected.has(item.id);
      checkbox.disabled = item.status !== 'published';
      const text = document.createElement('span');
      text.textContent = `${item.title} · ${contentTypeNames[item.contentType] ?? item.contentType} · ${statusLabel(item.status)}`;
      label.append(checkbox, text);
      contentOptions.append(label);
    }
    updateSelectedCount();
  }
  function updateSelectedCount() {
    const count = selectedContentIds.size;
    const output = document.querySelector<HTMLElement>('#selected-content-count');
    if (output) output.textContent = count === 1 ? '1 Inhalt ausgewählt.' : `${count} Inhalte ausgewählt.`;
  }
  function openEditor(dialog: HTMLDialogElement | null, form: HTMLFormElement | null) {
    if (!dialog || !form) return;
    if (activeEditor && activeEditor !== dialog) {
      closeEditor(activeEditor, activeEditor === contentDialog ? contentForm : productForm, false);
    }
    activeEditor = dialog;
    setDirty(false);
    dialog.showModal();
    dialog.querySelector<HTMLElement>('input:not([type="hidden"]),textarea,select,button')?.focus();
  }
  function closeEditor(dialog: HTMLDialogElement, form: HTMLFormElement | null, ask = true) {
    if (saving && ask) return;
    if (ask && dirty && !window.confirm('Änderungen verwerfen? Nicht gespeicherte Eingaben gehen verloren.')) return;
    setDirty(false);
    dialog.close();
    if (activeEditor === dialog) activeEditor = null;
    form?.reset();
    if (formField<HTMLInputElement>(form, 'id')) formField<HTMLInputElement>(form, 'id')!.value = '';
  }
  function resetContentEditor() {
    contentForm?.reset();
    if (formField<HTMLInputElement>(contentForm, 'id')) formField<HTMLInputElement>(contentForm, 'id')!.value = '';
    if (formField<HTMLInputElement>(contentForm, 'storageAssetId')) formField<HTMLInputElement>(contentForm, 'storageAssetId')!.value = '';
    const slug = formField<HTMLInputElement>(contentForm, 'slug');
    if (slug) { slug.value = ''; delete slug.dataset.manual; }
    if (contentUploadStatus) contentUploadStatus.textContent = '';
    if (contentEditorTitle) contentEditorTitle.textContent = 'Inhalt erstellen';
  }
  function resetProductEditor() {
    productForm?.reset();
    if (formField<HTMLInputElement>(productForm, 'id')) formField<HTMLInputElement>(productForm, 'id')!.value = '';
    if (formField<HTMLInputElement>(productForm, 'coverAssetId')) formField<HTMLInputElement>(productForm, 'coverAssetId')!.value = '';
    const slug = formField<HTMLInputElement>(productForm, 'slug');
    if (slug) { slug.value = ''; delete slug.dataset.manual; }
    if (coverUploadStatus) coverUploadStatus.textContent = '';
    selectedContentIds.clear();
    showCoverPreview(null);
    renderContentOptions();
    if (productEditorTitle) productEditorTitle.textContent = 'Produkt erstellen';
  }
  function openContentEditor(item?: ContentRecord) {
    resetContentEditor();
    if (item) {
      formField<HTMLInputElement>(contentForm, 'id')!.value = item.id;
      formField<HTMLInputElement>(contentForm, 'storageAssetId')!.value = item.storageAssetId ?? '';
      formField<HTMLSelectElement>(contentForm, 'contentType')!.value = item.contentType;
      formField<HTMLInputElement>(contentForm, 'title')!.value = item.title;
      formField<HTMLInputElement>(contentForm, 'slug')!.value = item.slug;
      formField<HTMLInputElement>(contentForm, 'slug')!.dataset.manual = 'true';
      formField<HTMLTextAreaElement>(contentForm, 'description')!.value = item.description;
      formField<HTMLTextAreaElement>(contentForm, 'body')!.value = item.body;
      formField<HTMLSelectElement>(contentForm, 'status')!.value = item.status;
      formField<HTMLInputElement>(contentForm, 'position')!.value = String(item.position);
      if (contentUploadStatus) contentUploadStatus.textContent = item.originalFilename
        ? `Aktuelle Datei: ${item.originalFilename}`
        : 'Keine Datei verknüpft.';
      if (contentEditorTitle) contentEditorTitle.textContent = `Inhalt bearbeiten: ${item.title}`;
    }
    openEditor(contentDialog, contentForm);
  }
  function openProductEditor(item?: ProductRecord) {
    resetProductEditor();
    if (item) {
      formField<HTMLInputElement>(productForm, 'id')!.value = item.id;
      formField<HTMLInputElement>(productForm, 'name')!.value = item.name;
      formField<HTMLInputElement>(productForm, 'slug')!.value = item.slug;
      formField<HTMLInputElement>(productForm, 'slug')!.dataset.manual = 'true';
      formField<HTMLSelectElement>(productForm, 'productType')!.value = item.productType;
      formField<HTMLTextAreaElement>(productForm, 'description')!.value = item.description;
      formField<HTMLInputElement>(productForm, 'price')!.value = (item.amountCents / 100).toFixed(2);
      formField<HTMLSelectElement>(productForm, 'billingInterval')!.value = item.billingInterval;
      formField<HTMLSelectElement>(productForm, 'status')!.value = item.status;
      formField<HTMLInputElement>(productForm, 'coverAssetId')!.value = item.coverAssetId ?? '';
      selectedContentIds = new Set(item.content.map((entry) => entry.id));
      renderContentOptions(selectedContentIds);
      showCoverPreview(item.coverAssetId
        ? `${siteRoot}api/store/products/${encodeURIComponent(item.slug)}/cover/`
        : null);
      if (productEditorTitle) productEditorTitle.textContent = `Produkt bearbeiten: ${item.name}`;
    }
    toggleMembershipBilling();
    openEditor(productDialog, productForm);
  }
  function toggleMembershipBilling() {
    const type = formField<HTMLSelectElement>(productForm, 'productType')?.value;
    const interval = formField<HTMLSelectElement>(productForm, 'billingInterval');
    const label = interval?.closest('label');
    if (label) label.hidden = type !== 'membership';
  }
  function showCoverPreview(url: string | null) {
    if (coverObjectUrl && coverObjectUrl !== url) URL.revokeObjectURL(coverObjectUrl);
    coverObjectUrl = url?.startsWith('blob:') ? url : null;
    if (!coverPreview || !coverPreviewImage) return;
    coverPreview.hidden = !url;
    if (url) coverPreviewImage.src = url;
    else coverPreviewImage.removeAttribute('src');
  }
  function openDeleteDialog(item: ContentRecord) {
    selectedForDeletion = item;
    if (deleteDescription) {
      deleteDescription.textContent = `„${item.title}“ wird endgültig gelöscht. Bestehende Käufe und Lernfortschritte bleiben geschützt; Inhalte mit früheren Zugängen können nicht gelöscht werden. Falls Produkte zugeordnet sind, musst du diese Zuordnungen zuerst entfernen. Dateien werden nur entfernt, wenn sie ausschließlich diesem Inhalt gehören.`;
    }
    if (deleteBlockedProducts) {
      deleteBlockedProducts.hidden = true;
      deleteBlockedProducts.replaceChildren();
    }
    deleteDialog?.showModal();
    confirmDelete?.focus();
  }
  async function uploadAsset(file: File, statusElement: HTMLElement | null, purpose: 'content' | 'cover' = 'content'): Promise<string> {
    const extensionTypes: Record<string, string> = {
      pdf: 'application/pdf', zip: 'application/zip', mp4: 'video/mp4',
      webm: 'video/webm', mov: 'video/quicktime', jpg: 'image/jpeg',
      jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp',
    };
    const contentType = file.type || extensionTypes[file.name.split('.').pop()?.toLowerCase() ?? ''] || '';
    if (statusElement) statusElement.textContent = `Bereite Upload vor: ${file.name}`;
    const prepared = await api<UploadResponse>(`${root}assets/`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ filename: file.name, contentType, byteSize: file.size, purpose }),
    });
    await new Promise<void>((resolve, reject) => {
      const request = new XMLHttpRequest();
      request.open('PUT', prepared.uploadUrl);
      for (const [name, value] of Object.entries(prepared.headers)) request.setRequestHeader(name, value);
      request.upload.addEventListener('progress', (event) => {
        if (event.lengthComputable && statusElement) {
          statusElement.textContent = `Upload ${file.name}: ${Math.round((event.loaded / event.total) * 100)} %`;
        }
      });
      request.addEventListener('load', () => {
        if (request.status >= 200 && request.status < 300) resolve();
        else reject(new Error(`Upload von ${file.name} fehlgeschlagen (HTTP ${request.status}).`));
      });
      request.addEventListener('error', () => reject(new Error(`Upload von ${file.name} fehlgeschlagen. Prüfe die Verbindung und Bucket-CORS.`)));
      request.addEventListener('abort', () => reject(new Error(`Upload von ${file.name} wurde abgebrochen.`)));
      request.send(file);
    });
    await api(`${root}assets/${encodeURIComponent(prepared.id)}/`, { method: 'PUT' });
    if (statusElement) statusElement.textContent = `Upload abgeschlossen: ${file.name}`;
    return prepared.id;
  }
  async function loadData(successMessage?: string) {
    report('Einträge werden geladen …');
    const [contentResult, productResult] = await Promise.all([
      api<{ content: ContentRecord[] }>(`${root}content/`),
      api<{ products: ProductRecord[] }>(`${root}products/`),
    ]);
    contents = contentResult.content;
    products = productResult.products;
    renderContentOptions(new Set(Array.from(productForm?.querySelectorAll<HTMLInputElement>('input[name="contentIds"]:checked') ?? []).map((input) => input.value)));
    renderContent();
    renderProducts();
    report(successMessage ?? `${contents.filter((item) => item.contentType !== 'article').length} Inhalte · ${products.length} Produkte`);
  }

  document.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((tab) => {
    tab.addEventListener('click', () => setActiveTab(tab.id === 'products-tab' ? 'products' : 'contents'));
    tab.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const next = tab.id === 'products-tab' ? 'contents' : 'products';
      document.getElementById(`${next}-tab`)?.focus();
      setActiveTab(next);
    });
  });
  document.querySelector<HTMLButtonElement>('#create-content')?.addEventListener('click', () => openContentEditor());
  document.querySelector<HTMLButtonElement>('#create-product')?.addEventListener('click', () => openProductEditor());
  contentSearch?.addEventListener('input', renderContent);
  productSearch?.addEventListener('input', renderProducts);
  contentStatusFilter?.addEventListener('change', renderContent);
  productStatusFilter?.addEventListener('change', renderProducts);
  contentOptionSearch?.addEventListener('input', () => {
    renderContentOptions(selectedContentIds);
  });
  contentOptions?.addEventListener('change', (event) => {
    const input = event.target;
    if (input instanceof HTMLInputElement && input.name === 'contentIds') {
      if (input.checked) selectedContentIds.add(input.value);
      else selectedContentIds.delete(input.value);
    }
    updateSelectedCount();
  });

  for (const form of [contentForm, productForm]) {
    form?.addEventListener('input', () => setDirty(true));
    form?.addEventListener('change', () => setDirty(true));
    form?.querySelectorAll<HTMLButtonElement>('[data-cancel-editor],[data-close-editor]').forEach((button) => {
      button.addEventListener('click', () => closeEditor(form === contentForm ? contentDialog! : productDialog!, form));
    });
    form?.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeEditor(form === contentForm ? contentDialog! : productDialog!, form);
    });
  }
  formField<HTMLSelectElement>(productForm, 'productType')?.addEventListener('change', toggleMembershipBilling);
  window.addEventListener('beforeunload', (event) => {
    if (!dirty) return;
    event.preventDefault();
  });

  formField<HTMLInputElement>(contentForm, 'title')?.addEventListener('input', () => suggestSlug(contentForm, 'title'));
  formField<HTMLInputElement>(productForm, 'name')?.addEventListener('input', () => suggestSlug(productForm, 'name'));
  for (const form of [contentForm, productForm]) {
    formField<HTMLInputElement>(form, 'slug')?.addEventListener('input', (event) => {
      (event.currentTarget as HTMLInputElement).dataset.manual = 'true';
    });
  }

  contentForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (saving || !contentForm) return;
    saving = true;
    const buttons = contentForm.querySelectorAll<HTMLButtonElement>('button');
    buttons.forEach((button) => { button.disabled = true; });
    try {
      report('Inhalt wird gespeichert …');
      const data = new FormData(contentForm);
      const id = String(data.get('id') ?? '');
      let storageAssetId = String(data.get('storageAssetId') ?? '') || null;
      const file = data.get('file');
      if (file instanceof File && file.size > 0) {
        storageAssetId = await uploadAsset(file, contentUploadStatus);
        formField<HTMLInputElement>(contentForm, 'storageAssetId')!.value = storageAssetId;
        formField<HTMLInputElement>(contentForm, 'file')!.value = '';
      }
      const payload = {
        contentType: data.get('contentType'),
        title: data.get('title'),
        slug: data.get('slug'),
        description: data.get('description'),
        body: data.get('body'),
        storageAssetId,
        status: data.get('status'),
        position: Number(data.get('position')),
      };
      await api(`${root}content/${id ? `${encodeURIComponent(id)}/` : ''}`, {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      closeEditor(contentDialog!, contentForm, false);
      resetContentEditor();
      await loadData('Inhalt gespeichert.');
    } catch (error) {
      report(error instanceof Error ? error.message : 'Der Inhalt konnte nicht gespeichert werden.');
    } finally {
      saving = false;
      buttons.forEach((button) => { button.disabled = false; });
    }
  });

  productForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (saving || !productForm) return;
    saving = true;
    const buttons = productForm.querySelectorAll<HTMLButtonElement>('button');
    buttons.forEach((button) => { button.disabled = true; });
    try {
      report('Produkt wird gespeichert …');
      const data = new FormData(productForm);
      const id = String(data.get('id') ?? '');
      let coverAssetId = String(data.get('coverAssetId') ?? '') || null;
      const coverFile = data.get('coverFile');
      if (coverFile instanceof File && coverFile.size > 0) {
        if (coverFile.size > 10 * 1024 * 1024) throw new Error('Coverbilder dürfen höchstens 10 MB groß sein.');
        coverAssetId = await uploadAsset(coverFile, coverUploadStatus, 'cover');
        formField<HTMLInputElement>(productForm, 'coverAssetId')!.value = coverAssetId;
        formField<HTMLInputElement>(productForm, 'coverFile')!.value = '';
      }
      const contentIds = Array.from(selectedContentIds);
      const payload = {
        slug: data.get('slug'),
        productType: data.get('productType'),
        name: data.get('name'),
        description: data.get('description'),
        status: data.get('status'),
        amountCents: Math.round(Number(data.get('price')) * 100),
        currency: 'eur',
        billingInterval: data.get('productType') === 'membership' ? data.get('billingInterval') : 'one_time',
        coverAssetId,
        contentIds,
      };
      await api(`${root}products/${id ? `${encodeURIComponent(id)}/` : ''}`, {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      closeEditor(productDialog!, productForm, false);
      resetProductEditor();
      await loadData('Produkt gespeichert.');
    } catch (error) {
      report(error instanceof Error ? error.message : 'Das Produkt konnte nicht gespeichert werden.');
    } finally {
      saving = false;
      buttons.forEach((button) => { button.disabled = false; });
    }
  });

  document.querySelector<HTMLButtonElement>('#cover-remove')?.addEventListener('click', () => {
    formField<HTMLInputElement>(productForm, 'coverAssetId')!.value = '';
    formField<HTMLInputElement>(productForm, 'coverFile')!.value = '';
    showCoverPreview(null);
    setDirty(true);
  });
  formField<HTMLInputElement>(productForm, 'coverFile')?.addEventListener('change', (event) => {
    const input = event.currentTarget as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) {
      input.value = '';
      report('Coverbilder dürfen höchstens 10 MB groß sein.');
      return;
    }
    showCoverPreview(URL.createObjectURL(file));
    if (coverUploadStatus) coverUploadStatus.textContent = `Ausgewählt: ${file.name} · Upload beim Speichern`;
  });

  document.querySelector<HTMLButtonElement>('#confirm-delete')?.addEventListener('click', async () => {
    if (!selectedForDeletion || !confirmDelete) return;
    confirmDelete.disabled = true;
    confirmDelete.textContent = 'Wird gelöscht …';
    if (deleteBlockedProducts) {
      deleteBlockedProducts.hidden = true;
      deleteBlockedProducts.replaceChildren();
    }
    try {
      const item = selectedForDeletion;
      const result = await api<{ success: boolean; warning?: string }>(
        `${root}content/${encodeURIComponent(item.id)}/`,
        { method: 'DELETE' },
      );
      deleteDialog?.close();
      selectedForDeletion = null;
      await loadData(result.warning ?? `„${item.title}“ wurde gelöscht.`);
    } catch (error) {
      report(error instanceof Error ? error.message : 'Der Inhalt konnte nicht gelöscht werden.');
      const typed = error as ApiError;
      if (deleteDescription && error instanceof Error) deleteDescription.textContent = error.message;
      if (typed.products?.length && deleteBlockedProducts) {
        const heading = document.createElement('strong');
        heading.textContent = 'Zuerst aus diesen Produkten entfernen:';
        const list = document.createElement('ul');
        for (const name of typed.products) {
          const entry = document.createElement('li');
          entry.textContent = name;
          list.append(entry);
        }
        deleteBlockedProducts.replaceChildren(heading, list);
        deleteBlockedProducts.hidden = false;
      }
    } finally {
      confirmDelete.disabled = false;
      confirmDelete.textContent = 'Inhalt löschen';
    }
  });
  deleteDialog?.addEventListener('close', () => { selectedForDeletion = null; });

  restoreListState();
  loadData().catch((error: unknown) => report(error instanceof Error ? error.message : 'Einträge konnten nicht geladen werden.'));
</script>

