---
import Base from '../../layouts/Base.astro';
import { getSessionAccount } from '../../lib/auth';

const account = await getSessionAccount(Astro.cookies.get('iftiin_session')?.value);
if (!account) return Astro.redirect('/login/', 302);
if (account.role !== 'admin') return Astro.redirect('/account/', 302);
const root = (path = '') => import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//, '');
---
<Base title="Produkte verwalten">
  <section class="section wrap commerce-admin" data-api-root={root('api/admin/')} data-site-root={root()}>
    <a class="breadcrumb" href={root('admin/')}>← Artikelverwaltung</a>
    <div class="section-label">Admin / Shop</div>
    <h1>Produkte &amp; Inhalte <em>verwalten.</em></h1>
    <p>Veröffentliche Inhalte und verknüpfe sie mit digitalen Produkten. Zahlungen bleiben deaktiviert, solange Stripe nicht ausdrücklich konfiguriert ist.</p>
    <p class="form-message" id="commerce-message" role="status" aria-live="polite"></p>

    <div class="commerce-columns">
      <section>
        <h2>Inhalt erstellen</h2>
        <form id="content-form" class="commerce-form">
          <input type="hidden" name="id" />
          <input type="hidden" name="storageAssetId" />
          <label>Inhaltstyp
            <select name="contentType"><option value="download">Digitaler Download</option><option value="lesson">Lektion</option><option value="video">Video</option></select>
          </label>
          <label>Titel<input name="title" maxlength="180" required /></label>
          <label>URL-Slug<input name="slug" maxlength="120" pattern="[a-z0-9]+(-[a-z0-9]+)*" required /></label>
          <label>Kurzbeschreibung<textarea name="description" maxlength="1000" rows="2"></textarea></label>
          <label>Inhalt / Lerntext<textarea name="body" maxlength="100000" rows="6"></textarea></label>
          <label>Datei (PDF, ZIP, MP4, WebM oder MOV; max. 500 MB)<input name="file" type="file" accept=".pdf,.zip,.mp4,.webm,.mov,application/pdf,application/zip,video/mp4,video/webm,video/quicktime" /></label>
          <label>Veröffentlichung
            <select name="status"><option value="draft">Entwurf</option><option value="published">Veröffentlicht</option></select>
          </label>
          <label>Reihenfolge<input name="position" type="number" min="0" max="10000" value="0" required /></label>
          <button class="pill-link" type="submit">Inhalt speichern <span>↗</span></button>
        </form>
        <h3>Vorhandene Inhalte</h3>
        <ul id="content-list" class="commerce-list"></ul>
      </section>

      <section>
        <h2 id="product-heading">Produkt erstellen</h2>
        <form id="product-form" class="commerce-form">
          <input type="hidden" name="id" />
          <input type="hidden" name="coverAssetId" />
          <label>Name<input name="name" maxlength="180" required /></label>
          <label>URL-Slug<input name="slug" maxlength="120" pattern="[a-z0-9]+(-[a-z0-9]+)*" required /></label>
          <label>Produkttyp
            <select name="productType">
              <option value="digital_download">Digitaler Download</option>
              <option value="premium_article">Premium-Artikel</option>
              <option value="online_course">Online-Kurs</option>
            </select>
          </label>
          <label>Beschreibung<textarea name="description" maxlength="2000" rows="3"></textarea></label>
          <label>Coverbild (optional, JPEG, PNG oder WebP; max. 10 MB)
            <input name="coverFile" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" />
          </label>
          <div class="cover-preview" id="cover-preview" hidden>
            <img id="cover-preview-image" alt="Produktcover-Vorschau" />
            <button class="text-link" id="cover-remove" type="button">Cover entfernen</button>
          </div>
          <label>Preis in Euro<input name="price" type="number" min="0.50" max="1000000" step="0.01" required /></label>
          <label>Status
            <select name="status"><option value="draft">Entwurf</option><option value="active">Aktiv</option><option value="archived">Archiviert</option></select>
          </label>
          <fieldset><legend>Zugeordnete Inhalte</legend><div id="content-options" class="content-options"></div></fieldset>
          <div class="form-actions">
            <button class="pill-link" type="submit">Produkt speichern <span>↗</span></button>
            <button class="text-link" id="product-reset" type="button">Formular zurücksetzen</button>
          </div>
        </form>
        <h3>Produktkatalog</h3>
        <ul id="product-list" class="commerce-list"></ul>
      </section>
    </div>
  </section>
</Base>

<script>
  type ContentRecord = {
    id: string; slug: string; title: string; description: string; body: string;
    contentType: string; status: string; storageAssetId: string | null; position: number;
  };
  type ProductRecord = {
    id: string; slug: string; name: string; description: string; productType: string;
    status: string; amountCents: number; coverAssetId: string | null; content: Pick<ContentRecord, 'id'>[];
  };
  type UploadResponse = { id: string; uploadUrl: string; headers: Record<string, string> };
  const root = document.querySelector<HTMLElement>('.commerce-admin')?.dataset.apiRoot ?? '/api/admin/';
  const message = document.querySelector<HTMLElement>('#commerce-message');
  const contentForm = document.querySelector<HTMLFormElement>('#content-form');
  const productForm = document.querySelector<HTMLFormElement>('#product-form');
  const contentList = document.querySelector<HTMLUListElement>('#content-list');
  const productList = document.querySelector<HTMLUListElement>('#product-list');
  const contentOptions = document.querySelector<HTMLDivElement>('#content-options');
  const productHeading = document.querySelector<HTMLElement>('#product-heading');
  const coverPreview = document.querySelector<HTMLDivElement>('#cover-preview');
  const coverPreviewImage = document.querySelector<HTMLImageElement>('#cover-preview-image');
  const siteRoot = document.querySelector<HTMLElement>('.commerce-admin')?.dataset.siteRoot ?? '/';
  let coverPreviewObjectUrl: string | null = null;

  function showCoverPreview(url: string | null) {
    if (coverPreviewObjectUrl && coverPreviewObjectUrl !== url) {
      URL.revokeObjectURL(coverPreviewObjectUrl);
    }
    coverPreviewObjectUrl = url?.startsWith('blob:') ? url : null;
    if (!coverPreview || !coverPreviewImage) return;
    if (!url) {
      coverPreview.hidden = true;
      coverPreviewImage.removeAttribute('src');
      return;
    }
    coverPreviewImage.src = url;
    coverPreview.hidden = false;
  }

  function report(text: string) {
    if (message) message.textContent = text;
  }
  async function api<T>(url: string, init?: RequestInit): Promise<T> {
    const response = await fetch(url, init);
    const result = await response.json() as T & { error?: string };
    if (!response.ok) throw new Error(result.error ?? 'Die Anfrage konnte nicht verarbeitet werden.');
    return result;
  }
  async function uploadAsset(file: File): Promise<string> {
    const extensionTypes: Record<string, string> = {
      pdf: 'application/pdf', zip: 'application/zip', mp4: 'video/mp4',
      webm: 'video/webm', mov: 'video/quicktime', jpg: 'image/jpeg',
      jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp',
    };
    const contentType = file.type || extensionTypes[file.name.split('.').pop()?.toLowerCase() ?? ''] || '';
    const prepared = await api<UploadResponse>(`${root}assets/`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ filename: file.name, contentType, byteSize: file.size }),
    });
    const uploaded = await fetch(prepared.uploadUrl, { method: 'PUT', headers: prepared.headers, body: file });
    if (!uploaded.ok) throw new Error('Die Datei konnte nicht in den privaten Speicher geladen werden.');
    await api(`${root}assets/${encodeURIComponent(prepared.id)}/`, { method: 'PUT' });
    return prepared.id;
  }
  function addListItem(
    parent: HTMLUListElement | null,
    label: string,
    actions: { text: string; run: () => void }[] = [],
  ) {
    if (!parent) return;
    const item = document.createElement('li');
    const text = document.createElement('span');
    text.textContent = label;
    item.append(text);
    if (actions.length) {
      const controls = document.createElement('span');
      controls.className = 'list-actions';
      for (const action of actions) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'text-link';
        button.textContent = action.text;
        button.addEventListener('click', action.run);
        controls.append(button);
      }
      item.append(controls);
    }
    parent.append(item);
  }
  function drawContent(items: ContentRecord[]) {
    if (contentList) contentList.replaceChildren();
    if (contentOptions) contentOptions.replaceChildren();
    for (const item of items) {
      addListItem(contentList, `${item.title} · ${item.contentType} · ${item.status}`, [{
        text: 'Bearbeiten',
        run: () => {
          if (!contentForm) return;
          (contentForm.elements.namedItem('id') as HTMLInputElement).value = item.id;
          (contentForm.elements.namedItem('storageAssetId') as HTMLInputElement).value = item.storageAssetId ?? '';
          (contentForm.elements.namedItem('contentType') as HTMLSelectElement).value = item.contentType;
          (contentForm.elements.namedItem('title') as HTMLInputElement).value = item.title;
          (contentForm.elements.namedItem('slug') as HTMLInputElement).value = item.slug;
          (contentForm.elements.namedItem('description') as HTMLTextAreaElement).value = item.description;
          (contentForm.elements.namedItem('body') as HTMLTextAreaElement).value = item.body;
          (contentForm.elements.namedItem('status') as HTMLSelectElement).value = item.status;
          (contentForm.elements.namedItem('position') as HTMLInputElement).value = String(item.position);
          window.scrollTo({ top: 0, behavior: 'smooth' });
        },
      }]);
      if (contentOptions) {
        const label = document.createElement('label');
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.name = 'contentIds';
        checkbox.value = item.id;
        checkbox.disabled = item.status !== 'published';
        const text = document.createElement('span');
        text.textContent = `${item.title}${item.status !== 'published' ? ' (zuerst veröffentlichen)' : ''}`;
        label.append(checkbox, text);
        contentOptions.append(label);
      }
    }
  }
  function selectProduct(product: ProductRecord) {
    if (!productForm) return;
    (productForm.elements.namedItem('id') as HTMLInputElement).value = product.id;
    (productForm.elements.namedItem('name') as HTMLInputElement).value = product.name;
    (productForm.elements.namedItem('slug') as HTMLInputElement).value = product.slug;
    (productForm.elements.namedItem('productType') as HTMLSelectElement).value = product.productType;
    (productForm.elements.namedItem('description') as HTMLTextAreaElement).value = product.description;
    (productForm.elements.namedItem('price') as HTMLInputElement).value = (product.amountCents / 100).toFixed(2);
    (productForm.elements.namedItem('status') as HTMLSelectElement).value = product.status;
    (productForm.elements.namedItem('coverAssetId') as HTMLInputElement).value = product.coverAssetId ?? '';
    showCoverPreview(product.coverAssetId
      ? `${siteRoot}api/store/products/${encodeURIComponent(product.slug)}/cover/`
      : null);
    const selected = new Set(product.content.map((item) => item.id));
    productForm.querySelectorAll<HTMLInputElement>('input[name="contentIds"]').forEach((input) => {
      input.checked = selected.has(input.value);
    });
    if (productHeading) productHeading.textContent = `Produkt bearbeiten: ${product.name}`;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
  async function loadData() {
    const [contentResult, productResult] = await Promise.all([
      api<{ content: ContentRecord[] }>(`${root}content/`),
      api<{ products: ProductRecord[] }>(`${root}products/`),
    ]);
    drawContent(contentResult.content);
    if (productList) productList.replaceChildren();
    for (const product of productResult.products) {
      addListItem(productList, `${product.name} · ${(product.amountCents / 100).toFixed(2)} € · ${product.status}`, [{
        text: 'Bearbeiten',
        run: () => selectProduct(product),
      }, ...(product.status !== 'archived' ? [{
        text: 'Archivieren',
        run: async () => {
          if (!window.confirm(`Produkt „${product.name}“ archivieren?`)) return;
          try {
            await api(`${root}products/${encodeURIComponent(product.id)}/`, { method: 'DELETE' });
            report('Produkt archiviert.');
            await loadData();
          } catch (error) {
            report(error instanceof Error ? error.message : 'Produkt konnte nicht archiviert werden.');
          }
        },
      }] : [])]);
    }
  }

  contentForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!contentForm) return;
    const formData = new FormData(contentForm);
    const file = formData.get('file');
    const id = String(formData.get('id') ?? '');
    let storageAssetId: string | null = null;
    try {
      report('Inhalt wird gespeichert …');
      storageAssetId = String(formData.get('storageAssetId') ?? '') || null;
      if (file instanceof File && file.size > 0) {
        storageAssetId = await uploadAsset(file);
      }
      const payload = {
        contentType: formData.get('contentType'),
        title: formData.get('title'),
        slug: formData.get('slug'),
        description: formData.get('description'),
        body: formData.get('body'),
        storageAssetId,
        status: formData.get('status'),
        position: Number(formData.get('position')),
      };
      await api(`${root}content/${id ? `${encodeURIComponent(id)}/` : ''}`, {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      contentForm.reset();
      (contentForm.elements.namedItem('id') as HTMLInputElement).value = '';
      (contentForm.elements.namedItem('storageAssetId') as HTMLInputElement).value = '';
      report('Inhalt gespeichert.');
      await loadData();
    } catch (error) {
      report(error instanceof Error ? error.message : 'Der Inhalt konnte nicht gespeichert werden.');
    }
  });

  productForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!productForm) return;
    const data = new FormData(productForm);
    const id = String(data.get('id') ?? '');
    const coverFile = data.get('coverFile');
    const contentIds = Array.from(productForm.querySelectorAll<HTMLInputElement>('input[name="contentIds"]:checked'), (input) => input.value);
    try {
      report('Produkt wird gespeichert …');
      let coverAssetId = String(data.get('coverAssetId') ?? '') || null;
      if (coverFile instanceof File && coverFile.size > 0) {
        if (coverFile.size > 10 * 1024 * 1024) throw new Error('Coverbilder dürfen höchstens 10 MB groß sein.');
        coverAssetId = await uploadAsset(coverFile);
      }
      const payload = {
        slug: data.get('slug'),
        productType: data.get('productType'),
        name: data.get('name'),
        description: data.get('description'),
        status: data.get('status'),
        amountCents: Math.round(Number(data.get('price')) * 100),
        currency: 'eur',
        billingInterval: 'one_time',
        coverAssetId,
        contentIds,
      };
      await api(`${root}products/${id ? `${encodeURIComponent(id)}/` : ''}`, {
        method: id ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      productForm.reset();
      (productForm.elements.namedItem('id') as HTMLInputElement).value = '';
      (productForm.elements.namedItem('coverAssetId') as HTMLInputElement).value = '';
      showCoverPreview(null);
      if (productHeading) productHeading.textContent = 'Produkt erstellen';
      report('Produkt gespeichert.');
      await loadData();
    } catch (error) {
      report(error instanceof Error ? error.message : 'Das Produkt konnte nicht gespeichert werden.');
    }
  });
  document.querySelector<HTMLButtonElement>('#product-reset')?.addEventListener('click', () => {
    productForm?.reset();
    if (productForm) (productForm.elements.namedItem('id') as HTMLInputElement).value = '';
    if (productForm) (productForm.elements.namedItem('coverAssetId') as HTMLInputElement).value = '';
    showCoverPreview(null);
    if (productHeading) productHeading.textContent = 'Produkt erstellen';
  });
  document.querySelector<HTMLInputElement>('input[name="coverFile"]')?.addEventListener('change', (event) => {
    const input = event.currentTarget as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) {
      input.value = '';
      report('Coverbilder dürfen höchstens 10 MB groß sein.');
      return;
    }
    coverPreviewObjectUrl = URL.createObjectURL(file);
    showCoverPreview(coverPreviewObjectUrl);
  });
  document.querySelector<HTMLButtonElement>('#cover-remove')?.addEventListener('click', () => {
    if (!productForm) return;
    (productForm.elements.namedItem('coverAssetId') as HTMLInputElement).value = '';
    (productForm.elements.namedItem('coverFile') as HTMLInputElement).value = '';
    showCoverPreview(null);
  });
  loadData().catch((error: unknown) => report(error instanceof Error ? error.message : 'Shopdaten konnten nicht geladen werden.'));
</script>

<style>
  .commerce-admin { padding-top: 3rem; padding-bottom: 6rem; }
  .commerce-admin h1 { font-size: clamp(2.5rem, 7vw, 5rem); margin: 0.8rem 0 1rem; }
  .commerce-admin > p:not(.form-message) { color: var(--muted); line-height: 1.7; max-width: 760px; }
  .commerce-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; margin-top: 3rem; }
  .commerce-columns h2 { margin-top: 0; }
  .commerce-columns h3 { margin-top: 2.5rem; }
  .commerce-form { display: grid; gap: 1rem; }
  .commerce-form label { display: grid; gap: 0.4rem; }
  .commerce-form input:not([type="checkbox"]):not([type="file"]), .commerce-form textarea, .commerce-form select {
    width: 100%; padding: 0.75rem; border: 1px solid var(--line); border-radius: 8px; background: white; color: inherit; font: inherit;
  }
  .commerce-form input[type="file"] { max-width: 100%; }
  .cover-preview { display: grid; justify-items: start; gap: 0.6rem; }
  .cover-preview[hidden] { display: none; }
  .cover-preview img { width: min(100%, 360px); aspect-ratio: 16 / 9; object-fit: cover; border-radius: 10px; }
  .commerce-form fieldset { border: 1px solid var(--line); border-radius: 10px; padding: 1rem; }
  .content-options { display: grid; gap: 0.5rem; max-height: 240px; overflow: auto; }
  .content-options label { display: flex; grid-template-columns: auto 1fr; align-items: center; gap: 0.6rem; }
  .commerce-list { list-style: none; padding: 0; display: grid; gap: 0.65rem; }
  .commerce-list li { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.9rem 1rem; border: 1px solid var(--line); border-radius: 10px; }
  .list-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .form-actions { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
  @media (max-width: 800px) { .commerce-columns { grid-template-columns: 1fr; } }
</style>
