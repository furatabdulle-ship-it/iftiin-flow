---
import ArrowIcon from '../components/ArrowIcon.astro';
import IftiinSun from '../components/brand/IftiinSun.astro';
import StorePriceOptions from '../components/StorePriceOptions.astro';
import Base from '../layouts/Base.astro';
import { getSessionAccount } from '../lib/auth';
import { listPublicProducts } from '../lib/commerce';
import { isGuestAccessEmailConfigured } from '../lib/password-reset-email';
import type { ProductCategory } from '../lib/product-categories';
import { isCheckoutConfigured } from '../lib/stripe';
import { localeHref, t } from '../lib/i18n';

const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
const availableProducts = await listPublicProducts();
const products = locale === 'en'
  ? availableProducts.filter((product) => product.nameEn && product.content.every((item) => item.titleEn))
  : availableProducts;
const account = await getSessionAccount(Astro.cookies.get('iftiin_session')?.value);
const lockedSlug = Astro.url.searchParams.get('locked');
const cancelled = Astro.url.searchParams.get('checkout') === 'cancelled';
const hasLockedProduct = lockedSlug
  ? products.some((product) => product.content.some((item) => item.slug === lockedSlug))
  : false;
const checkoutReady = isCheckoutConfigured();
const guestAccessReady = isGuestAccessEmailConfigured();
const root = (path = '') => localeHref(import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//, ''), locale);
const typeNames: Record<string, string> = {
  digital_download: copy('store.digitalDownload'),
  premium_article: copy('store.premiumArticle'),
  online_course: copy('store.onlineCourse'),
  bundle: copy('store.bundle'),
  membership: copy('store.membership'),
};
const categoryNames: Record<ProductCategory, string> = {
  knowledge_products: copy('store.categoryKnowledge'),
  creative_skill_kits: copy('store.categorySkillKits'),
  new_ways_of_working_kits: copy('store.categoryWorkKits'),
};
---
<Base title={copy('common.shop')} description={copy('store.description')}>
  <section class="interior-hero wrap store-hero">
    <div class="section-label">{copy('store.label')}</div>
    <h1>{copy('store.headlineStart')} <em>{copy('store.headlineAccent')}</em></h1>
    <p>{copy('store.description')}</p>
  </section>
  <section class="section wrap store-content">
    {lockedSlug && <aside class="store-notice" role="status">
      {hasLockedProduct
        ? copy('store.lockedAvailable')
        : copy('store.lockedUnavailable')}
    </aside>}
    {cancelled && <aside class="store-notice" role="status">{copy('store.cancelled')}</aside>}
    {products.length ? <div class="store-grid">
      {products.map((product) => {
        const name = locale === 'en' ? product.nameEn ?? product.name : product.name;
        const description = locale === 'en' ? product.descriptionEn : product.description;
        return <article class="store-card">
          <a class="store-card-link" href={root(`store/${encodeURIComponent(product.slug)}/`)}>
            {product.coverAssetId && <img
              class="store-card-cover"
              src={root(`api/store/products/${encodeURIComponent(product.slug)}/cover/`)}
              alt=""
              loading="lazy"
              decoding="async"
            />}
            <span class="store-card-labels">
              <span class="section-label">{typeNames[product.productType]}</span>
              {product.storeCategory && <span class="store-category-label">{categoryNames[product.storeCategory]}</span>}
            </span>
            <h2>{name}</h2>
            {description && <p>{description}</p>}
            <StorePriceOptions product={product} mode="summary" />
            <span class="store-card-cta">{copy('store.viewProduct')} <ArrowIcon /></span>
          </a>
        </article>;
      })}
    </div> : <div class="empty-state">
      <IftiinSun class="empty-symbol" color="var(--violet)" />
      <h2>{copy('store.emptyTitle')}</h2>
      <p>{copy('store.emptyDescription')}</p>
    </div>}
    <section class="store-categories" aria-labelledby="store-categories-title">
      <h2 class="section-label" id="store-categories-title">{copy('store.productCategories')}</h2>
      <ul>
        <li>{copy('store.categoryKnowledge')}</li>
        <li>{copy('store.categorySkillKits')}</li>
        <li>{copy('store.categoryWorkKits')}</li>
      </ul>
    </section>
    {!account && checkoutReady && guestAccessReady && <p class="guest-access-note">
      {copy('store.accessAfterPurchase')}
      <a href={root('guest-access/')}>{copy('store.resendAccess')} <ArrowIcon /></a>
    </p>}
  </section>
</Base>

<style>
  .store-hero { padding-bottom: 2rem; }
  .store-content { min-height: 40vh; padding-top: 1rem; padding-bottom: 6rem; }
  .store-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1.25rem; }
  .store-card { border: 1px solid var(--line); border-radius: 20px; overflow: hidden; transition: border-color .2s ease, transform .2s ease; }
  .store-card:hover { border-color: var(--violet); transform: translateY(-2px); }
  .store-card-link { display: flex; height: 100%; flex-direction: column; align-items: flex-start; padding: 1.25rem; color: inherit; text-decoration: none; }
  .store-card-link:focus-visible { outline: 2px solid var(--violet); outline-offset: -3px; border-radius: 20px; }
  .store-card-cover { width: calc(100% + 2.5rem); max-width: none; aspect-ratio: 4 / 3; object-fit: cover; margin: -1.25rem -1.25rem 1.25rem; background: var(--surface, #f3f0e8); }
  .store-card-labels { display: flex; flex-wrap: wrap; align-items: center; gap: .45rem; }
  .store-category-label { padding: .25rem .55rem; border: 1px solid var(--line); border-radius: 999px; font-size: .75rem; font-weight: 700; }
  .store-card h2 { margin: .75rem 0 .25rem; font-size: 1.5rem; }
  .store-card p { color: var(--muted); line-height: 1.7; }
  .store-card-cta { display: inline-flex; align-items: center; gap: .5rem; margin-top: 1rem; font-weight: 700; }
  .store-categories { margin-top: 4rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .store-categories h2 { margin: 0; }
  .store-categories ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .store-categories li {
    padding-top: .9rem;
    border-top: 1px solid var(--line);
    font: 700 clamp(1.05rem, 1.8vw, 1.35rem)/1.25 Manrope, Arial, sans-serif;
    letter-spacing: -.035em;
  }
  .guest-access-note { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; color: var(--muted); }
  .guest-access-note a { color: inherit; }
  .store-notice { margin-bottom: 1.5rem; padding: 1rem 1.25rem; border: 1px solid var(--line); border-radius: 12px; }
  @media (max-width: 640px) {
    .store-categories ul { grid-template-columns: 1fr; gap: .5rem; }
  }
</style>
