---
import ArrowIcon from '../components/ArrowIcon.astro';
import IftiinSun from '../components/brand/IftiinSun.astro';
import Base from '../layouts/Base.astro';
import { getSessionAccount } from '../lib/auth';
import { listPublicProducts } from '../lib/commerce';
import { isGuestAccessEmailConfigured } from '../lib/password-reset-email';
import { isCheckoutConfigured } from '../lib/stripe';
import { localeHref, t } from '../lib/i18n';

const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
const availableProducts = await listPublicProducts();
const products = locale === 'en'
  ? availableProducts.filter((product) => product.nameEn && product.content.every((item) => item.titleEn))
  : availableProducts;
const account = await getSessionAccount(Astro.cookies.get('iftiin_session')?.value);
const lockedSlug = Astro.url.searchParams.get('locked');
const cancelled = Astro.url.searchParams.get('checkout') === 'cancelled';
const hasLockedProduct = lockedSlug
  ? products.some((product) => product.content.some((item) => item.slug === lockedSlug))
  : false;
const checkoutReady = isCheckoutConfigured();
const guestAccessReady = isGuestAccessEmailConfigured();
const root = (path = '') => localeHref(import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//, ''), locale);
const formatPrice = (amount: number, currency: string) => new Intl.NumberFormat(locale === 'en' ? 'en-IE' : 'de-DE', {
  style: 'currency',
  currency: currency.toUpperCase(),
}).format(amount / 100);
const typeNames: Record<string, string> = {
  digital_download: copy('store.digitalDownload'),
  premium_article: copy('store.premiumArticle'),
  online_course: copy('store.onlineCourse'),
  bundle: copy('store.bundle'),
  membership: copy('store.membership'),
};
---
<Base title={copy('common.shop')} description={copy('store.description')}>
  <section class="interior-hero wrap store-hero">
    <div class="section-label">{copy('store.label')}</div>
    <h1>Visions into <em>practice.</em></h1>
    <p>{copy('store.description')}</p>
  </section>
  <section class="section wrap store-content" data-checkout-preparing={copy('store.checkoutPreparing')} data-checkout-error={copy('store.checkoutError')}>
    {lockedSlug && <aside class="store-notice" role="status">
      {hasLockedProduct
        ? copy('store.lockedAvailable')
        : copy('store.lockedUnavailable')}
    </aside>}
    {cancelled && <aside class="store-notice" role="status">{copy('store.cancelled')}</aside>}
    {products.length ? <div class="store-grid">
      {products.map((product) => <article class="store-card">
        {product.coverAssetId && <img
          class="store-card-cover"
          src={root(`api/store/products/${encodeURIComponent(product.slug)}/cover/`)}
          alt={`${locale === 'en' ? 'Cover' : 'Cover'}: ${locale === 'en' ? product.nameEn : product.name}`}
          loading="lazy"
          decoding="async"
        />}
        <div class="store-card-top">
          <span class="section-label">{typeNames[product.productType]}</span>
        </div>
        <h2>{locale === 'en' ? product.nameEn : product.name}</h2>
        {(locale === 'en' ? product.descriptionEn : product.description) && <p>{locale === 'en' ? product.descriptionEn : product.description}</p>}
        {product.content.length > 0 && <ul>
          {product.content.map((item) => <li>{locale === 'en' ? item.titleEn : item.title}</li>)}
        </ul>}
        <div class="store-price-options">
          {product.prices.map((price) => <div class="store-price-option">
            <strong>{formatPrice(price.amountCents, price.currency)}{price.billingInterval !== 'one_time' ? ` / ${price.billingInterval === 'month' ? copy('store.month') : copy('store.year')}` : ` ${copy('store.oneTime')}`}</strong>
            {!account && <label class="guest-email-label">
              {copy('store.emailForAccess')}
              <input class="guest-email" type="email" autocomplete="email" maxlength="254" required />
            </label>}
            <button
              class="pill-link checkout-button"
              type="button"
              data-product-id={product.id}
              data-price-id={price.priceId}
              disabled={!checkoutReady || (!account && !guestAccessReady)}
            >
              {checkoutReady
                ? (!account && !guestAccessReady
                  ? copy('store.emailAccessUnavailable')
                  : account
                  ? (price.billingInterval === 'one_time' ? copy('store.buySecurely') : copy('store.startSubscription'))
                  : (price.billingInterval === 'one_time' ? copy('store.buyWithoutAccount') : copy('store.startGuestSubscription')))
                : copy('store.checkoutUnavailable')} <ArrowIcon />
            </button>
          </div>)}
        </div>
      </article>)}
    </div> : <div class="empty-state">
      <IftiinSun class="empty-symbol" color="var(--violet)" />
      <h2>{copy('store.emptyTitle')}</h2>
      <p>{copy('store.emptyDescription')}</p>
    </div>}
    {!account && checkoutReady && guestAccessReady && <p class="guest-access-note">
      {copy('store.accessAfterPurchase')}
      <a href={root('guest-access/')}>{copy('store.resendAccess')} <ArrowIcon /></a>
    </p>}
    <p class="form-message" id="store-message" role="status" aria-live="polite"></p>
  </section>
</Base>

<script>
  const message = document.querySelector<HTMLElement>('#store-message');
  const storeContent = document.querySelector<HTMLElement>('.store-content');
  document.querySelectorAll<HTMLButtonElement>('.checkout-button').forEach((button) => {
    button.addEventListener('click', async () => {
      if (!message || !button.dataset.productId || !button.dataset.priceId) return;
      const emailInput = button.closest('.store-card')?.querySelector<HTMLInputElement>('.guest-email');
      if (emailInput && !emailInput.reportValidity()) return;
      message.textContent = storeContent?.dataset.checkoutPreparing ?? 'Preparing secure checkout …';
      button.disabled = true;
      try {
        const email = emailInput?.value.trim();
        const response = await fetch('/api/checkout/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: button.dataset.productId,
            priceId: button.dataset.priceId,
            ...(email ? { email } : {}),
          }),
        });
        const result = await response.json() as { checkoutUrl?: string; error?: string };
        if (!response.ok || !result.checkoutUrl) throw new Error(result.error ?? storeContent?.dataset.checkoutError ?? 'Checkout could not be started.');
        window.location.assign(result.checkoutUrl);
      } catch (error) {
        message.textContent = error instanceof Error ? error.message : storeContent?.dataset.checkoutError ?? 'Checkout could not be started.';
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .store-hero { padding-bottom: 2rem; }
  .store-content { min-height: 40vh; padding-top: 1rem; padding-bottom: 6rem; }
  .store-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1.25rem; }
  .store-card { border: 1px solid var(--line); border-radius: 20px; padding: 1.5rem; display: flex; flex-direction: column; align-items: flex-start; }
  .store-card-cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 12px; margin-bottom: 1.25rem; background: var(--surface, #f3f0e8); }
  .store-card-top { width: 100%; display: flex; justify-content: space-between; gap: 1rem; align-items: center; }
  .store-card h2 { margin: 1.25rem 0 0.5rem; font-size: 1.5rem; }
  .store-card p { color: var(--muted); line-height: 1.7; }
  .store-card ul { padding-left: 1.25rem; line-height: 1.8; margin-bottom: 1.5rem; }
  .store-price-options { width: 100%; margin-top: auto; display: grid; gap: .75rem; }
  .store-price-option { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-top: .75rem; border-top: 1px solid var(--line); }
  .store-price-option .pill-link { margin: 0; }
  .guest-email-label { display: grid; width: 100%; gap: .35rem; font-size: .9rem; }
  .guest-email { width: 100%; min-height: 42px; padding: .5rem .7rem; border: 1px solid var(--line); border-radius: 8px; background: transparent; color: inherit; font: inherit; }
  .guest-access-note { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.5rem; color: var(--muted); }
  .guest-access-note a { color: inherit; }
  .store-notice { margin-bottom: 1.5rem; padding: 1rem 1.25rem; border: 1px solid var(--line); border-radius: 12px; }
  @media (max-width: 520px) { .store-price-option { align-items: flex-start; flex-direction: column; } }
</style>
