---
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { t } from '../lib/i18n';
const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
---
<Base title={copy('legal.title')} description={copy('legal.description')}>
  <section class="interior-hero wrap legal-hero">
    <div class="section-label">{copy('legal.label')}</div>
    <h1>{copy('legal.title')}</h1>
    <p>{copy('legal.statement')}</p>
  </section>
  <section class="section wrap legal-content">
    {locale === 'en' && <p class="legal-translation-note">{copy('legal.translationNotice')}</p>}
    <h2>{copy('legal.provider')}</h2>
    <p>
      Furat Abdulle<br />
      Gärtnerweg 62<br />
      60322 Frankfurt am Main (Innenstadt II)<br />
      Deutschland
    </p>

    <h2>{copy('legal.contact')}</h2>
    <p>E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a></p>

    <h2>{copy('legal.responsible')}</h2>
    <p>
      {copy('legal.responsibility')}<br />
      Furat Abdulle<br />
      Gärtnerweg 62<br />
      60322 Frankfurt am Main (Innenstadt II)<br />
      Deutschland
    </p>
  </section>
</Base>

<style>
  .legal-hero { padding-bottom: 2rem; }
  .legal-content { max-width: 800px; padding-top: 1rem; padding-bottom: 6rem; }
  .legal-content h2 { margin: 2.5rem 0 0.75rem; font-size: 1.25rem; }
  .legal-content p { margin: 0; line-height: 1.8; }
  .legal-content a { color: inherit; text-underline-offset: 0.2em; }
</style>
