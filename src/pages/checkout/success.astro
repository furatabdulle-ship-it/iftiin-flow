---
import ArrowIcon from '../../components/ArrowIcon.astro';
import Base from '../../layouts/Base.astro';
import { localeHref, t } from '../../lib/i18n';
const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
---
<Base title={copy('checkout.title')}>
  <section class="interior-hero wrap checkout-success">
    <div class="section-label">{copy('checkout.label')}</div>
    <h1>{copy('checkout.thanks')}</h1>
    <p>{copy('checkout.message')}</p>
    <a class="pill-link" href={localeHref('/store/', locale)}>{copy('checkout.backToShop')} <ArrowIcon /></a>
  </section>
</Base>

<style>
  .checkout-success { max-width: 760px; min-height: 55vh; padding-top: 5rem; }
</style>
