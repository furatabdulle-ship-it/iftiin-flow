---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { publishedArticles, formatDate } from '../../lib/content';
import { pillars,formatNames } from '../../config';
export async function getStaticPaths() { return (await publishedArticles()).map(article=>({params:{slug:article.id},props:{article}})); }
const {article} = Astro.props;
const {Content} = await render(article);
const pillar = pillars.find(p=>p.slug===article.data.pillar);
const root = (path = '') => import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//,'');
---
<Base title={article.data.title} description={article.data.description}><article><header class="article-header wrap"><a class="breadcrumb" href={root(`topics/${pillar?.slug}/`)}>← {pillar?.name}</a><div class="section-label">{formatNames[article.data.format]} / {pillar?.name}</div><h1>{article.data.title}</h1><p>{article.data.description}</p><div class="article-meta"><span>{formatDate(article.data.date)}</span>{article.data.updated && <span>Aktualisiert: {formatDate(article.data.updated)}</span>}</div></header><div class="prose"><Content />{article.data.sources.length>0 && <section class="sources"><h2>Quellen</h2><ol>{article.data.sources.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>)}</ol></section>}</div></article></Base>
