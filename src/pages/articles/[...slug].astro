---
import ArrowIcon from '../../components/ArrowIcon.astro';
import Base from '../../layouts/Base.astro';
import { renderArticleMarkdown, getPublishedArticle } from '../../lib/articles';
import { formatDate } from '../../lib/content';
import { getSessionAccount } from '../../lib/auth';
import { hasArticleAccess, hasGuestArticleAccess } from '../../lib/commerce';
import { getGuestAccessEmail } from '../../lib/guest-access';
import { getVideoEmbedUrl } from '../../lib/validation';
import { localeHref, localizedFormatNames, localizedPillars, t } from '../../lib/i18n';

const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
const article = Astro.params.slug ? await getPublishedArticle(Astro.params.slug, locale) : null;
if (article?.data.loginRequired || article?.data.requiresPurchase) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  const account = await getSessionAccount(Astro.cookies.get('iftiin_session')?.value);
  const guestEmail = await getGuestAccessEmail(Astro.cookies.get('iftiin_guest_access')?.value);
  const accountAllowed = Boolean(account && (
    account.role === 'admin' ||
    !article.data.requiresPurchase ||
    await hasArticleAccess(account.id, article.id)
  ));
  const guestAllowed = Boolean(
    guestEmail &&
    article.data.requiresPurchase &&
    await hasGuestArticleAccess(guestEmail, article.id),
  );
  if (!accountAllowed && !guestAllowed) {
    if (article.data.requiresPurchase) {
      return Astro.redirect(localeHref(`/store/?locked=${encodeURIComponent(article.slug)}`, locale), 302);
    }
    return Astro.redirect(localeHref(`/login/?next=${encodeURIComponent(Astro.url.pathname)}`, locale), 302);
  }
}
if (!article) Astro.response.status = 404;
const html = article ? await renderArticleMarkdown(article.body) : '';
const pillar = article && localizedPillars(locale).find((item) => item.slug === article.data.pillar);
const formatNames = localizedFormatNames(locale);
const videoEmbedUrl = article?.data.videoUrl ? getVideoEmbedUrl(article.data.videoUrl) : null;
const root = (path = '') => localeHref(import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//, ''), locale);
---
<Base title={article?.data.title ?? copy('article.notFoundTitle')} description={article?.data.description ?? copy('article.notFoundDescription')}>
  {article ? <>
  <article>
    <header class="article-header wrap">
      <a class="breadcrumb" href={root(`topics/${pillar?.slug}/`)}><ArrowIcon direction="left" /> {pillar?.name}</a>
      <div class="section-label">{formatNames[article.data.format] ?? (locale === 'en' ? 'Article' : 'Artikel')} / {pillar?.name}</div>
      <h1>{article.data.title}</h1>
      <p>{article.data.description}</p>
      <div class="article-meta">
        <span>{formatDate(article.data.date, locale)}</span>
        {article.data.updated && <span>{copy('article.updated')} {formatDate(article.data.updated, locale)}</span>}
        {article.data.requiresPurchase && <span>{copy('article.premium')}</span>}
        {article.data.loginRequired && !article.data.requiresPurchase && <span>{copy('article.loginRequired')}</span>}
      </div>
    </header>
    {videoEmbedUrl && <div class="video-player wrap">
      <iframe
        src={videoEmbedUrl}
        title={article.data.title}
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
      <p class="video-disclaimer">{copy('article.videoDisclaimer')}</p>
    </div>}
    <div class="prose" set:html={html}></div>
    {article.data.sources.length > 0 && <section class="sources wrap">
      <h2>{copy('article.sources')}</h2>
      <ol>{article.data.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} <ArrowIcon /></a></li>)}</ol>
    </section>}
  </article>
  </> : <section class="interior-hero wrap">
    <div class="section-label">{copy('article.notFoundLabel')}</div>
    <h1>{copy('article.notFoundTitle')}</h1>
    <p>{copy('article.notFoundDescription')}</p>
    <a class="pill-link" href={root('explore/')}>{copy('article.backToExplore')} <ArrowIcon /></a>
  </section>}
</Base>

<style>
  .video-player{max-width:900px;margin:0 auto 42px}
  .video-player iframe{display:block;width:100%;aspect-ratio:16/9;border:0;background:#141515}
  .video-disclaimer{font-size:13px;color:var(--muted)}
</style>
