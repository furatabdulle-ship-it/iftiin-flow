---
import ArrowIcon from '../components/ArrowIcon.astro';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import IftiinSun from '../components/brand/IftiinSun.astro';
import { pillars } from '../config';
import { publishedArticles } from '../lib/content';
import { getSessionAccount } from '../lib/auth';
const account = await getSessionAccount(Astro.cookies.get('iftiin_session')?.value);
const articles = await publishedArticles(Boolean(account));
const root = (path = '') => import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//,'');
---
<Base title="Explore" description="Entdecke Ideen zu Systems & Power sowie Skills & Agency.">
<section class="interior-hero wrap"><div class="section-label">Visions / Themes</div><h1>Explore <em>the thinking.</em></h1><p>Zwei miteinander verbundene Themenwelten. Eine Frage: Wie können wir besser verstehen, urteilen und handeln?</p></section>
<section class="section articles-section">
  <div class="wrap">
    <div class="section-heading">
      <div><div class="section-label">Library</div><h2>All <em>articles.</em></h2></div>
    </div>
    {articles.length > 0
      ? <div class="card-grid">{articles.map(article => <ArticleCard article={article} />)}</div>
      : <div class="empty-state">
        <IftiinSun class="empty-symbol" color="var(--violet)" />
        <h3>Articles in progress.</h3>
        <p>Die Bibliothek wächst mit den ersten veröffentlichten Essays, Notes und Research-Beiträgen. Bis dahin kannst du die beiden Themenwelten erkunden.</p>
      </div>}
  </div>
</section>
<section class="section wrap compact-section">
  <div class="pillars">{pillars.map(p => <a class="pillar-row" href={root(`topics/${p.slug}/`)}>
    <span class="pillar-number">{p.number}</span>
    <span class="pillar-main"><strong>{p.name}</strong><small>{p.description}</small></span>
    <ArrowIcon class="pillar-arrow" />
  </a>)}</div>
</section>
</Base>
