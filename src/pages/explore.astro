---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { pillars } from '../config';
import { publishedArticles } from '../lib/content';
const articles = await publishedArticles();
const root = (path = '') => import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//,'');
---
<Base title="Explore" description="Entdecke Ideen und Perspektiven auf Wissen, KI, Institutionen und Handlungsfähigkeit.">
<section class="interior-hero wrap"><div class="section-label">Ideas / Themes</div><h1>Explore <em>the thinking.</em></h1><p>Fünf miteinander verbundene Themenwelten. Eine Frage: Wie können wir besser verstehen, urteilen und handeln?</p></section>
<section class="section wrap compact-section"><div class="pillars">{pillars.map(p=><a class="pillar-row" href={root(`topics/${p.slug}/`)}><span class="pillar-number">{p.number}</span><span class="pillar-main"><strong>{p.name}</strong><small>{p.description}</small></span><span class="pillar-arrow">↗</span></a>)}</div></section>
<section class="section articles-section"><div class="wrap"><div class="section-heading"><div><div class="section-label">Library</div><h2>All <em>ideas.</em></h2></div></div>{articles.length > 0 ? <div class="card-grid">{articles.map(a=><ArticleCard article={a}/>)}</div> : <div class="empty-state"><span class="empty-symbol">✳</span><h3>Ideas in progress.</h3><p>Die Bibliothek wächst mit den ersten veröffentlichten Essays, Notes und Research-Beiträgen. Bis dahin kannst du die fünf Themenwelten erkunden.</p></div>}</div></section>
</Base>
