---
import ArrowIcon from '../components/ArrowIcon.astro';
import Base from '../layouts/Base.astro';
import { localeHref, t } from '../lib/i18n';

const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
const token = Astro.url.searchParams.get('token') ?? '';
const validTokenShape = /^[A-Za-z0-9_-]{43}$/.test(token);
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---
<Base title={copy('auth.newPasswordTitle')} description={copy('auth.newPasswordDescription')}>
  <section class="interior-hero wrap account-hero">
    <div class="section-label">{copy('auth.passwordResetLabel')}</div>
    <h1>{copy('auth.newPasswordHeading')}</h1>
    {validTokenShape ? <>
      <p>{copy('auth.choosePassword')}</p>
      <form class="account-form" id="password-reset-form">
        <input type="hidden" name="token" value={token} />
        <label for="password">{copy('auth.newPasswordTitle')}</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
        <label for="password-confirm">{copy('auth.repeatPassword')}</label>
        <input id="password-confirm" name="passwordConfirm" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
        <button class="pill-link" type="submit">{copy('auth.changePassword')} <ArrowIcon /></button>
      </form>
      <p class="form-message" id="password-reset-message" role="status" aria-live="polite"></p>
      <p class="account-switch" id="password-reset-login" hidden><a href={localeHref('/login/', locale)}>{copy('auth.toLogin')} <ArrowIcon /></a></p>
    </> : <>
      <p>{copy('auth.invalidResetLink')}</p>
      <p class="account-switch"><a href={localeHref('/forgot-password/', locale)}>{copy('auth.requestNewLink')} <ArrowIcon /></a></p>
    </>}
  </section>
</Base>

<style>
  @import '../styles/account.css';
  #password-reset-login[hidden] { display: none; }
  #password-reset-form[hidden] { display: none; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#password-reset-form');
  const message = document.querySelector<HTMLElement>('#password-reset-message');
  const loginLink = document.querySelector<HTMLElement>('#password-reset-login');
  const locale = document.documentElement.lang;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !message) return;

    const data = new FormData(form);
    if (data.get('password') !== data.get('passwordConfirm')) {
      message.textContent = locale === 'en' ? 'The passwords do not match.' : 'Die Passwörter stimmen nicht überein.';
      return;
    }

    message.textContent = locale === 'en' ? 'Please wait …' : 'Bitte warten …';
    try {
      const response = await fetch('/api/auth/password-reset/confirm/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: data.get('token'), password: data.get('password') }),
      });
      const result = await response.json() as { message?: string; error?: string };
      if (!response.ok) {
        message.textContent = locale === 'en'
          ? 'The password could not be changed. The reset link may have expired; request a new one.'
          : result.error ?? 'Das Passwort konnte nicht geändert werden.';
        return;
      }

      message.textContent = locale === 'en' ? 'Your password has been changed.' : result.message ?? 'Dein Passwort wurde geändert.';
      form.hidden = true;
      if (loginLink) loginLink.hidden = false;
    } catch {
      message.textContent = locale === 'en'
        ? 'The server is unavailable right now. Please try again.'
        : 'Der Server ist momentan nicht erreichbar. Bitte versuche es erneut.';
    }
  });
</script>
