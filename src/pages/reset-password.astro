---
import ArrowIcon from '../components/ArrowIcon.astro';
import Base from '../layouts/Base.astro';

const token = Astro.url.searchParams.get('token') ?? '';
const validTokenShape = /^[A-Za-z0-9_-]{43}$/.test(token);
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---
<Base title="Neues Passwort festlegen" description="Lege ein neues Passwort für dein iftiin flow. Konto fest.">
  <section class="interior-hero wrap account-hero">
    <div class="section-label">Konto / Passwort zurücksetzen</div>
    <h1>Neues Passwort <em>festlegen.</em></h1>
    {validTokenShape ? <>
      <p>Wähle ein neues, einzigartiges Passwort mit mindestens 12 Zeichen.</p>
      <form class="account-form" id="password-reset-form">
        <input type="hidden" name="token" value={token} />
        <label for="password">Neues Passwort</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
        <label for="password-confirm">Passwort wiederholen</label>
        <input id="password-confirm" name="passwordConfirm" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
        <button class="pill-link" type="submit">Passwort ändern <ArrowIcon /></button>
      </form>
      <p class="form-message" id="password-reset-message" role="status" aria-live="polite"></p>
      <p class="account-switch" id="password-reset-login" hidden><a href="/login/">Zur Anmeldung <ArrowIcon /></a></p>
    </> : <>
      <p>Dieser Link ist ungültig oder unvollständig. Fordere einen neuen Reset-Link an.</p>
      <p class="account-switch"><a href="/forgot-password/">Neuen Link anfordern <ArrowIcon /></a></p>
    </>}
  </section>
</Base>

<style>
  @import '../styles/account.css';
  #password-reset-login[hidden] { display: none; }
  #password-reset-form[hidden] { display: none; }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#password-reset-form');
  const message = document.querySelector<HTMLElement>('#password-reset-message');
  const loginLink = document.querySelector<HTMLElement>('#password-reset-login');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !message) return;

    const data = new FormData(form);
    if (data.get('password') !== data.get('passwordConfirm')) {
      message.textContent = 'Die Passwörter stimmen nicht überein.';
      return;
    }

    message.textContent = 'Bitte warten …';
    try {
      const response = await fetch('/api/auth/password-reset/confirm/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token: data.get('token'), password: data.get('password') }),
      });
      const result = await response.json() as { message?: string; error?: string };
      if (!response.ok) {
        message.textContent = result.error ?? 'Das Passwort konnte nicht geändert werden.';
        return;
      }

      message.textContent = result.message ?? 'Dein Passwort wurde geändert.';
      form.hidden = true;
      if (loginLink) loginLink.hidden = false;
    } catch {
      message.textContent = 'Der Server ist momentan nicht erreichbar. Bitte versuche es erneut.';
    }
  });
</script>
