---
import ArrowIcon from '../components/ArrowIcon.astro';
import Base from '../layouts/Base.astro';
import { isPasswordResetEmailConfigured } from '../lib/password-reset-email';

const passwordResetEnabled = isPasswordResetEmailConfigured();
---
<Base title="Passwort vergessen" description="Fordere einen sicheren Link zum Zurücksetzen deines Passworts an.">
  <section class="interior-hero wrap account-hero">
    <div class="section-label">Konto / Passwort zurücksetzen</div>
    <h1>Passwort <em>vergessen?</em></h1>
    {passwordResetEnabled ? <>
      <p>Gib die E-Mail-Adresse deines Kontos ein. Wenn ein Konto dazu existiert, schicken wir dir einen Link zum Zurücksetzen.</p>
      <form class="account-form" id="password-reset-request-form">
        <label for="email">E-Mail-Adresse</label>
        <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
        <p class="form-message" id="password-reset-request-message" role="status" aria-live="polite"></p>
        <button class="pill-link" type="submit">Reset-Link anfordern <ArrowIcon /></button>
      </form>
    </> : <p>Der Passwort-Reset ist derzeit nicht verfügbar. Bitte versuche es später erneut.</p>}
    <p class="account-switch"><a href="/login/">Zurück zur Anmeldung <ArrowIcon /></a></p>
  </section>
</Base>

<style>
  @import '../styles/account.css';
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#password-reset-request-form');
  const message = document.querySelector<HTMLElement>('#password-reset-request-message');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !message) return;

    message.textContent = 'Bitte warten …';
    const data = new FormData(form);
    try {
      const response = await fetch('/api/auth/password-reset/request/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: data.get('email') }),
      });
      const result = await response.json() as { message?: string; error?: string };
      message.textContent = response.ok
        ? result.message ?? 'Falls die Adresse zu einem Konto gehört, erhältst du in Kürze eine E-Mail.'
        : result.error ?? 'Die Anfrage ist fehlgeschlagen.';
    } catch {
      message.textContent = 'Der Server ist momentan nicht erreichbar. Bitte versuche es erneut.';
    }
  });
</script>
