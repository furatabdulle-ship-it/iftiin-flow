---
import ArrowIcon from '../components/ArrowIcon.astro';
import Base from '../layouts/Base.astro';
import { isPasswordResetEmailConfigured } from '../lib/password-reset-email';
import { localeHref, t } from '../lib/i18n';

const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
const passwordResetEnabled = isPasswordResetEmailConfigured();
---
<Base title={copy('auth.passwordResetTitle')} description={copy('auth.passwordResetDescription')}>
  <section class="interior-hero wrap account-hero">
    <div class="section-label">{copy('auth.passwordResetLabel')}</div>
    <h1>{copy('auth.passwordForgotten')}</h1>
    {passwordResetEnabled ? <>
      <p>{copy('auth.resetPrompt')}</p>
      <form class="account-form" id="password-reset-request-form">
        <label for="email">{copy('auth.email')}</label>
        <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
        <p class="form-message" id="password-reset-request-message" role="status" aria-live="polite"></p>
        <button class="pill-link" type="submit">{copy('auth.resetLink')} <ArrowIcon /></button>
      </form>
    </> : <p>{copy('auth.resetUnavailable')}</p>}
    <p class="account-switch"><a href={localeHref('/login/', locale)}>{copy('auth.backToLogin')} <ArrowIcon /></a></p>
  </section>
</Base>

<style>
  @import '../styles/account.css';
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#password-reset-request-form');
  const message = document.querySelector<HTMLElement>('#password-reset-request-message');
  const locale = document.documentElement.lang;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !message) return;

    message.textContent = locale === 'en' ? 'Please wait …' : 'Bitte warten …';
    const data = new FormData(form);
    try {
      const response = await fetch('/api/auth/password-reset/request/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: data.get('email') }),
      });
      const result = await response.json() as { message?: string; error?: string };
      message.textContent = response.ok
        ? locale === 'en'
          ? 'If this address is associated with an account, you will receive an email shortly.'
          : result.message ?? 'Falls die Adresse zu einem Konto gehört, erhältst du in Kürze eine E-Mail.'
        : locale === 'en'
          ? 'The request could not be completed. Please check the address and try again.'
          : result.error ?? 'Die Anfrage ist fehlgeschlagen.';
    } catch {
      message.textContent = locale === 'en'
        ? 'The server is unavailable right now. Please try again.'
        : 'Der Server ist momentan nicht erreichbar. Bitte versuche es erneut.';
    }
  });
</script>
