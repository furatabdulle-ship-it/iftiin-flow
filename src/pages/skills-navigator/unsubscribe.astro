---
import Base from '../../layouts/Base.astro';
import { localeHref, t } from '../../lib/i18n';

const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
const root = (path = '') => localeHref(
  import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//, ''),
  locale,
);
const token = Astro.url.searchParams.get('token') ?? '';
const status = Astro.url.searchParams.get('status');
const result = status === 'unsubscribed'
  ? copy('waitlist.unsubscribeSuccess')
  : status === 'invalid' || !token
    ? copy('waitlist.unsubscribeInvalid')
    : '';
Astro.response.headers.set('Cache-Control', 'no-store');
---

<Base title={copy('waitlist.unsubscribeTitle')} description={copy('waitlist.unsubscribeDescription')}>
  <section class="section wrap waitlist-action">
    <div class="section-label">{copy('waitlist.eyebrow')}</div>
    <h1>{copy('waitlist.unsubscribeTitle')}</h1>
    <p>{copy('waitlist.unsubscribeDescription')}</p>
    {result ? (
      <p class="waitlist-result" role="status">{result}</p>
    ) : (
      <form method="post" action={root('api/skills-navigator-waitlist/unsubscribe/')}>
        <input type="hidden" name="token" value={token} />
        <button class="pill-link" type="submit">{copy('waitlist.unsubscribeSubmit')}</button>
      </form>
    )}
  </section>
</Base>

<style>
  .waitlist-action { max-width: 760px; min-height: 55vh; padding-top: clamp(4rem, 10vw, 8rem); }
  .waitlist-action h1 { max-width: 18ch; margin: .75rem 0 1rem; font-size: clamp(2.5rem, 7vw, 5rem); letter-spacing: -.06em; line-height: 1; }
  .waitlist-action > p { max-width: 620px; color: var(--muted); line-height: 1.7; }
  .waitlist-action form { margin-top: 2rem; }
  .waitlist-action button { border: 0; cursor: pointer; font: inherit; }
  .waitlist-result { padding: 1rem; border: 1px solid var(--line); }
</style>
