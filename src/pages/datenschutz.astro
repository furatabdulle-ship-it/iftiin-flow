---
import Base from '../layouts/Base.astro';
import { site } from '../config';
import { localeHref, t } from '../lib/i18n';

const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
const siteRoot = import.meta.env.BASE_URL.replace(/\/$/, '/');
const legalHref = localeHref(`${siteRoot}impressum/`, locale);
---

<Base title={copy('privacy.title')} description={copy('privacy.description')}>
  <section class="interior-hero wrap privacy-hero">
    <div class="section-label">{copy('privacy.label')}</div>
    <h1>{copy('privacy.title')}</h1>
    <p>{copy('privacy.intro')}</p>
  </section>
  <section class="section wrap privacy-content">
    {locale === 'en' && <p class="privacy-translation-note">{copy('privacy.translationNotice')}</p>}

    <h2>{copy('privacy.controllerTitle')}</h2>
    <p>{copy('privacy.controllerBody')} <a href={legalHref}>{locale === 'en' ? 'Legal notice' : 'Impressum'}</a></p>
    <p>E-Mail: <a href={`mailto:${site.email}`}>{site.email}</a></p>

    <h2>{copy('privacy.dataTitle')}</h2>
    <p>{copy('privacy.dataBody')}</p>

    <h2>{copy('privacy.inquiriesTitle')}</h2>
    <p>{copy('privacy.inquiriesBody')}</p>

    <h2>{copy('privacy.pilotTitle')}</h2>
    <p>{copy('privacy.pilotBody')}</p>

    <h2>{copy('privacy.accountsTitle')}</h2>
    <p>{copy('privacy.accountsBody')}</p>

    <h2>{copy('privacy.purchasesTitle')}</h2>
    <p>{copy('privacy.purchasesBody')}</p>

    <h2>{copy('privacy.providersTitle')}</h2>
    <p>{copy('privacy.providersBody')}</p>

    <h2>{copy('privacy.retentionTitle')}</h2>
    <p>{copy('privacy.retentionBody')}</p>

    <h2>{copy('privacy.rightsTitle')}</h2>
    <p>{copy('privacy.rightsBody')}</p>

    <h2>{copy('privacy.securityTitle')}</h2>
    <p>{copy('privacy.securityBody')}</p>

    <h2>{copy('privacy.contactTitle')}</h2>
    <p>{copy('privacy.contactBody')}</p>
  </section>
</Base>

<style>
  .privacy-hero { padding-bottom: 2rem; }
  .privacy-hero > p { max-width: 760px; color: var(--muted); line-height: 1.75; }
  .privacy-content { max-width: 800px; padding-top: 1rem; padding-bottom: 6rem; }
  .privacy-content h2 { margin: 2.5rem 0 .75rem; font-size: 1.25rem; }
  .privacy-content p { margin: 0 0 .75rem; line-height: 1.8; }
  .privacy-content a { color: inherit; text-underline-offset: .2em; }
  .privacy-translation-note { padding: 1rem; background: #f1ece2; }
</style>
