---
import ArrowIcon from '../components/ArrowIcon.astro';
import { site } from '../config';
import IftiinSun from '../components/brand/IftiinSun.astro';
import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/home.css';
import '../styles/brand.css';
const { title, description = site.shortDescription, home = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — Wissen. Urteilskraft. Handlungsfähigkeit.`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const prefix = import.meta.env.BASE_URL;
const root = (path = '') => prefix.replace(/\/$/, '/') + path.replace(/^\//,'');
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141515" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={root('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href={root('apple-touch-icon.png')} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ 'home-page': home }}>
    <a class="skip" href="#content">Zum Inhalt springen</a>
    {!home && <div class="announcement">Wissen · Urteilskraft · Handlungsfähigkeit <span aria-hidden="true"><ArrowIcon /></span></div>}
    <header class="site-header wrap">
      <a class="wordmark" href={root('')} aria-label="iftiin flow. Startseite"><IftiinSun class="wordmark-sun" /><span class="wordmark-text">iftiin<span class="wordmark-accent"> flow.</span></span></a>
        {home ? <>
          <nav class="home-nav" aria-label="Hauptnavigation">
            <a href={root('explore/')}>Magazin</a>
            <a href={root('store/')}>Shop <ArrowIcon /></a>
            <a href={root('about/')}>Über IFTIIN</a>
          </nav>
          <a class="home-account" href={root('account/')}>Mein Konto</a>
          <div class="header-actions">
          <button class="pill pill--solid" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
            <span data-menu-label>Menü</span><span class="burger" aria-hidden="true"><i></i><i></i></span>
          </button>
          </div>
        </> : <nav aria-label="Hauptnavigation">
          <a href={root('explore/')}>Explore</a>
          <a href={root('about/')}>About</a>
          <a href={root('account/')}>Konto</a>
          <a href={root('store/')}>Shop</a>
          {site.showResearch && <a href={root('research/')}>Research</a>}
          {site.showLearning && <a href={root('learning/')}>Learning</a>}
          {site.showTools && <a href={root('tools/')}>Tools</a>}
          {site.showBooking && site.bookingUrl && <a class="nav-cta" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">Buchen <ArrowIcon /></a>}
        </nav>}
    </header>
    {home && <nav class="site-menu" id="site-menu" aria-label="Hauptmenü" inert>
      <a href={root('explore/')}>Magazin</a>
      <a href={root('store/')}>Shop</a>
      <a href={root('about/')}>Über IFTIIN</a>
      <a href={root('account/')}>Mein Konto</a>
      {site.showResearch && <a href={root('research/')}>Research</a>}
      {site.showLearning && <a href={root('learning/')}>Learning</a>}
      {site.showTools && <a href={root('tools/')}>Tools</a>}
      {site.showBooking && site.bookingUrl && <a href={site.bookingUrl} target="_blank" rel="noopener noreferrer">Buchen <ArrowIcon /></a>}
    </nav>}
    <main id="content"><slot /></main>
    <footer class="footer">
      <div class="wrap footer-grid">
        <div><a class="wordmark" href={root('')}><IftiinSun class="wordmark-sun" /><span class="wordmark-text">iftiin<span class="wordmark-accent"> flow.</span></span></a><p>Understand complexity.<br/>Think with clarity. Act with agency.</p></div>
        <div class="footer-links"><a href={root('explore/')}>Explore</a><a href={root('store/')}>Shop</a><a href={root('about/')}>About</a><a href={root('impressum/')}>Impressum</a>{site.email && <a href={`mailto:${site.email}`}>Kontakt</a>}{site.showNewsletter && site.newsletterUrl && <a href={site.newsletterUrl}>Newsletter <ArrowIcon /></a>}</div>
        <div class="footer-bottom">© {new Date().getFullYear()} iftiin flow. · Unabhängige Wissensplattform</div>
      </div>
    </footer>
    {home && <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const menu = document.querySelector<HTMLElement>('#site-menu');

      if (menuToggle && menu) {
        const setMenuOpen = (open: boolean) => {
          document.body.classList.toggle('menu-open', open);
          menuToggle.setAttribute('aria-expanded', String(open));
          menuToggle.querySelector('[data-menu-label]')!.textContent = open ? 'Schließen' : 'Menü';
          menu.inert = !open;
        };

        menuToggle.addEventListener('click', () => {
          setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMenuOpen(false);
        });
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setMenuOpen(false));
        });
      }

      const rotator = document.querySelector<HTMLElement>('[data-rotator]');
      if (rotator && !reduceMotion) {
        let index = 0;
        window.setInterval(() => {
          index = (index + 1) % rotator.children.length;
          rotator.style.transform = `translateY(-${index * 0.98}em)`;
        }, 2200);
      }

      const hero = document.querySelector<HTMLElement>('[data-parallax]');
      const orbit = document.querySelector<HTMLElement>('[data-orbit]');
      if (hero && orbit && window.matchMedia('(pointer: fine)').matches && !reduceMotion) {
        let frame: number | null = null;
        hero.addEventListener('mousemove', (event) => {
          if (frame !== null) return;
          frame = window.requestAnimationFrame(() => {
            frame = null;
            const bounds = hero.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width - 0.5;
            const y = (event.clientY - bounds.top) / bounds.height - 0.5;
            orbit.style.transform = `translate(${Math.round(x * -60)}px, ${Math.round(y * -40)}px)`;
          });
        });
      }
    </script>}
  </body>
</html>
