---
import ArrowIcon from './ArrowIcon.astro';
import { localeHref, t } from '../lib/i18n';
const { mode, redirectTo = '/account/' } = Astro.props as { mode: 'login' | 'register'; redirectTo?: string };
const register = mode === 'register';
const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
---
<form class="account-form" id="auth-form" data-endpoint={mode} data-redirect-to={localeHref(redirectTo, locale)} data-locale={locale} data-wait={copy('account.wait')} data-request-failed={copy('auth.requestFailed')} data-server-unavailable={copy('account.serverUnavailable')}>
  {register && <>
    <label for="display-name">{copy('auth.name')}</label>
    <input id="display-name" name="displayName" type="text" autocomplete="name" maxlength="80" required />
  </>}
  <label for="email">{copy('auth.email')}</label>
  <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required />
  <label for="password">{copy('auth.password')}</label>
  <input
    id="password"
    name="password"
    type="password"
    autocomplete={register ? 'new-password' : 'current-password'}
    minlength="12"
    maxlength="128"
    required
  />
  {register && <p class="form-hint">{copy('auth.passwordHint')}</p>}
  <p class="form-message" id="auth-message" role="status" aria-live="polite"></p>
  <button class="pill-link" type="submit">{register ? copy('auth.createAccount') : copy('auth.login')} <ArrowIcon /></button>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#auth-form');
  const message = document.querySelector<HTMLElement>('#auth-message');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !message) return;

    const endpoint = form.dataset.endpoint;
    const data = new FormData(form);
    message.textContent = form.dataset.wait ?? 'Please wait …';
    try {
      const response = await fetch(`/api/auth/${endpoint}/`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: data.get('email'),
          password: data.get('password'),
          ...(endpoint === 'register' ? { displayName: data.get('displayName') } : {}),
        }),
      });
      const result = await response.json() as { error?: string };
      if (!response.ok) {
        const locale = form.dataset.locale ?? 'de';
        message.textContent = locale === 'en'
          ? (response.status === 401
            ? 'The email or password is incorrect.'
            : response.status === 409
              ? 'An account with this email already exists.'
              : response.status === 429
                ? 'Too many attempts. Please wait a moment and try again.'
                : form.dataset.requestFailed ?? 'The request failed.')
          : result.error ?? 'Die Anfrage ist fehlgeschlagen.';
        return;
      }
      window.location.assign(form.dataset.redirectTo ?? '/account/');
    } catch {
      message.textContent = form.dataset.serverUnavailable ?? 'The server is unavailable right now. Please try again.';
    }
  });
</script>
