---
import ArrowIcon from './ArrowIcon.astro';
import type { ProductRecord } from '../lib/commerce';
import { localeHref, t } from '../lib/i18n';

interface Props {
  product: ProductRecord;
  mode?: 'summary' | 'checkout';
  signedIn?: boolean;
  checkoutReady?: boolean;
  guestAccessReady?: boolean;
}

const {
  product,
  mode = 'summary',
  signedIn = false,
  checkoutReady = false,
  guestAccessReady = false,
} = Astro.props;
const locale = Astro.locals.locale;
const copy = (key: Parameters<typeof t>[1]) => t(locale, key);
const formatPrice = (amount: number, currency: string) => new Intl.NumberFormat(locale === 'en' ? 'en-IE' : 'de-DE', {
  style: 'currency',
  currency: currency.toUpperCase(),
}).format(amount / 100);
const courseRequiresAccount = product.productType === 'online_course';
const registrationNext = encodeURIComponent(`${Astro.url.pathname}${Astro.url.search}`);
const registerHref = localeHref(`/register/?next=${registrationNext}`, locale);
const loginHref = localeHref(`/login/?next=${registrationNext}`, locale);
---
<div class:list={['store-price-options', `store-price-options--${mode}`]} data-store-price-options data-checkout-preparing={copy('store.checkoutPreparing')} data-checkout-error={copy('store.checkoutError')}>
  {product.prices.map((price) => <div class="store-price-option">
    <strong>{formatPrice(price.amountCents, price.currency)}{price.billingInterval !== 'one_time' ? ` / ${price.billingInterval === 'month' ? copy('store.month') : copy('store.year')}` : ` ${copy('store.oneTime')}`}</strong>
    {mode === 'checkout' && <>
      {courseRequiresAccount && !signedIn ? (
        <div class="course-account-required">
          <p>{copy('store.courseAccountRequired')}</p>
          <a class="pill-link" href={registerHref}>{copy('account.createAccount')} <ArrowIcon /></a>
          <a class="course-sign-in" href={loginHref}>{copy('community.signInCta')} <ArrowIcon /></a>
        </div>
      ) : <>
        {!signedIn && <label class="guest-email-label">
          {copy('store.emailForAccess')}
          <input class="guest-email" type="email" autocomplete="email" maxlength="254" required />
        </label>}
        <button
          class="pill-link checkout-button"
          type="button"
          data-product-id={product.id}
          data-price-id={price.priceId}
          disabled={!checkoutReady || (!signedIn && !guestAccessReady)}
        >
          {checkoutReady
            ? (!signedIn && !guestAccessReady
              ? copy('store.emailAccessUnavailable')
              : signedIn
              ? (price.billingInterval === 'one_time' ? copy('store.buySecurely') : copy('store.startSubscription'))
              : (price.billingInterval === 'one_time' ? copy('store.buyWithoutAccount') : copy('store.startGuestSubscription')))
            : copy('store.checkoutUnavailable')} <ArrowIcon />
        </button>
      </>}
    </>}
  </div>)}
</div>
{mode === 'checkout' && <p class="form-message store-checkout-status" data-checkout-status role="status" aria-live="polite"></p>}

<script>
  document.querySelectorAll<HTMLButtonElement>('.checkout-button').forEach((button) => {
    button.addEventListener('click', async () => {
      if (!button.dataset.productId || !button.dataset.priceId) return;
      const options = button.closest<HTMLElement>('[data-store-price-options]');
      const message = options?.parentElement?.querySelector<HTMLElement>('[data-checkout-status]');
      if (!options || !message) return;
      const emailInput = button.closest('.store-price-option')?.querySelector<HTMLInputElement>('.guest-email');
      if (emailInput && !emailInput.reportValidity()) return;
      message.textContent = options.dataset.checkoutPreparing ?? 'Preparing secure checkout …';
      button.disabled = true;
      try {
        const email = emailInput?.value.trim();
        const response = await fetch('/api/checkout/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            productId: button.dataset.productId,
            priceId: button.dataset.priceId,
            ...(email ? { email } : {}),
          }),
        });
        const result = await response.json() as { checkoutUrl?: string; error?: string };
        if (!response.ok || !result.checkoutUrl) throw new Error(result.error ?? options.dataset.checkoutError ?? 'Checkout could not be started.');
        window.location.assign(result.checkoutUrl);
      } catch (error) {
        message.textContent = error instanceof Error ? error.message : options.dataset.checkoutError ?? 'Checkout could not be started.';
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .store-price-options { width: 100%; display: grid; gap: .75rem; }
  .store-price-options--summary { margin-top: auto; padding-top: 1rem; }
  .store-price-option { display: grid; gap: .75rem; padding-top: .75rem; border-top: 1px solid var(--line); }
  .store-price-options--summary .store-price-option { padding: 0; border: 0; }
  .store-price-options--summary strong { font-size: 1.05rem; }
  .store-price-options--checkout { margin-top: 1.5rem; }
  .store-price-option .pill-link { width: 100%; margin: 0; justify-content: center; }
  .guest-email-label { display: grid; width: 100%; gap: .35rem; font-size: .9rem; }
  .guest-email { width: 100%; min-height: 42px; padding: .5rem .7rem; border: 1px solid var(--line); border-radius: 8px; background: transparent; color: inherit; font: inherit; }
  .store-checkout-status { margin: .75rem 0 0; }
  .course-account-required { display: grid; justify-items: start; gap: .75rem; }
  .course-account-required p { margin: 0; color: var(--muted); line-height: 1.6; }
  .course-account-required .pill-link { justify-content: center; }
  .course-sign-in { font-weight: 700; text-underline-offset: 3px; }
</style>
