---
import ArrowIcon from './ArrowIcon.astro';
import { localizedFormatNames, localizedPillars, t } from '../lib/i18n';
import { formatDate } from '../lib/content';
const { article } = Astro.props;
const locale = Astro.locals.locale;
const author = t(locale, 'article.author');
const pillar = localizedPillars(locale).find(p => p.slug === article.data.pillar);
const formatNames = localizedFormatNames(locale);
const root = (path = '') => {
  const url = new URL(import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//,''), Astro.url);
  url.searchParams.set('lang', locale);
  return `${url.pathname}${url.search}`;
};
---
<a class="article-card" href={root(`articles/${article.slug}/`)}>
  <div class="article-card-top"><span>{formatNames[article.data.format] || 'Artikel'}</span><ArrowIcon class="arrow" /></div>
  <h3>{article.data.title}</h3>
  <p>{article.data.description}</p>
  <div class="article-card-byline">{author}</div>
  <div class="article-card-bottom"><span>{pillar?.name}</span><span>{formatDate(article.data.date, locale)}</span></div>
</a>

<style>
  .article-card-byline { margin-top: .75rem; font-size: .82rem; font-weight: 600; }
</style>
