---
import { pillars, formatNames } from '../config';
import { formatDate } from '../lib/content';
const { article } = Astro.props;
const pillar = pillars.find(p => p.slug === article.data.pillar);
const root = (path = '') => import.meta.env.BASE_URL.replace(/\/$/, '/') + path.replace(/^\//,'');
---
<a class="article-card" href={root(`articles/${article.id}/`)}>
  <div class="article-card-top"><span>{formatNames[article.data.format] || 'Artikel'}</span><span class="arrow">↗</span></div>
  <h3>{article.data.title}</h3>
  <p>{article.data.description}</p>
  <div class="article-card-bottom"><span>{pillar?.name}</span><span>{formatDate(article.data.date)}</span></div>
</a>
