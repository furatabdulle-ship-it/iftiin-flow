SITE_URL=http://localhost:4321
DATABASE_URL=postgresql://iftiin_flow:local_development_only@localhost:5432/iftiin_flow
POSTGRES_PASSWORD=local_development_only
# Set true only if a trusted proxy overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Gmail API OAuth credentials for Workspace password-reset emails.
# Password reset links are enabled only when these and HTTPS SITE_URL are valid.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Commerce bleibt standardmäßig deaktiviert. Für Stripe zuerst Testschlüssel
# und den Webhook-Endpunkt /api/webhooks/stripe/ konfigurieren.
STRIPE_CHECKOUT_ENABLED=false
STRIPE_LIVE_MODE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Privater S3-kompatibler Speicher für Downloads und Kursvideos.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=
# Set false for Railway Buckets and other virtual-hosted-style endpoints.
STORAGE_FORCE_PATH_STYLE=true
